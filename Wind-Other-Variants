            TextSize = 17,
            FontFace = Font.new(Creator.Font, Enum.FontWeight.Bold),
            TextXAlignment = Enum.TextXAlignment.Left,
            ThemeTag = { TextColor3 = "DialogTitle" },
            ZIndex = 502,
            Parent = box,
        })

        if dCfg.Content then
            Creator.New("TextLabel", {
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                Text = tostring(dCfg.Content),
                TextSize = 14,
                TextTransparency = 0.25,
                TextWrapped = true,
                FontFace = Font.new(Creator.Font, Enum.FontWeight.Medium),
                TextXAlignment = Enum.TextXAlignment.Left,
                ThemeTag = { TextColor3 = "DialogContent" },
                ZIndex = 502,
                Parent = box,
            })
        end

        local btnRow = Creator.New("Frame", {
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundTransparency = 1,
            ZIndex = 502,
            Parent = box,
        }, {
            Creator.New("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal,
                HorizontalAlignment = Enum.HorizontalAlignment.Right,
                Padding = UDim.new(0, 8),
            }),
        })

        for _, b in ipairs(dCfg.Buttons or { { Title = "OK" } }) do
            local btn = Creator.NewRoundFrame(8, "Squircle", {
                Size = UDim2.new(0, 0, 1, 0),
                AutomaticSize = Enum.AutomaticSize.X,
                ThemeTag = { ImageColor3 = b.Variant == "Secondary" and "Button" or "Primary" },
                ZIndex = 503,
                Parent = btnRow,
            }, {
                Creator.New("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }),
                Creator.New("TextLabel", {
                    Size = UDim2.new(0, 0, 1, 0),
                    AutomaticSize = Enum.AutomaticSize.X,
                    BackgroundTransparency = 1,
                    Text = b.Title or "OK",
                    TextSize = 14,
                    FontFace = Font.new(Creator.Font, Enum.FontWeight.SemiBold),
                    TextColor3 = Color3.new(1, 1, 1),
                    ZIndex = 504,
                }),
            }, true)

            btn.MouseButton1Click:Connect(function()
                overlay:Destroy()
                Creator.SafeCallback(b.Callback)
            end)
        end
    end

    function Window:Toggle()
        visible = not visible
        mainFrame.Visible = visible
        openPill.Visible = not visible
    end

    function Window:Destroy()
        Creator.DisconnectAll()
        if screenGui then screenGui:Destroy() end
    end

    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        bodyFrame.Visible = not minimized
        Creator.Tween(mainFrame, 0.22, {
            Size = minimized and UDim2.fromOffset(winSize.X.Offset, 48) or winSize
        }):Play()
    end)

    closeBtn.MouseButton1Click:Connect(function()
        Window:Toggle()
    end)

    openPill.MouseButton1Click:Connect(function()
        Window:Toggle()
    end)

    local toggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift
    Creator.AddSignal(UserInputService.InputBegan, function(inp, gp)
        if not gp and inp.UserInputType == Enum.UserInputType.Keyboard and inp.KeyCode == toggleKey then
            Window:Toggle()
        end
    end)

    return Window
end

return WindUI
