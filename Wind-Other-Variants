-- Sebelumnya puluhan SetTitle dipanggil SETIAP FRAME (RenderStepped) -> UI re-layout terus-menerus = lag.
UI_LastTitle = setmetatable({}, { __mode = "k" })
function UI_SetTitle(element, text)
    if not element or not element.SetTitle then return end
    if UI_LastTitle[element] == text then return end
    UI_LastTitle[element] = text
    element:SetTitle(text)
end

-- [FIX LAG] Pembatas frekuensi: mengembalikan true hanya jika sudah lewat `interval` detik
function UI_Tick(state, interval)
    local now = os.clock()
    if now - (state.t or 0) < interval then return false end
    state.t = now
    return true
end


