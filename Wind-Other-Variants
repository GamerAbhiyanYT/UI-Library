-- [5] CONSOLE / LOG
function Elements.Console(parent, cfg)
    cfg = cfg or {}
    local maxLines = cfg.MaxLines or 100
    local height = cfg.Height or 140
    local lines = {}

    local levelHex = {
        INFO = "#94A3B8",
        OK = "#33C759",
        SUCCESS = "#33C759",
        WARN = "#F59E0B",
        ERR = "#EF4444",
        ERROR = "#EF4444",
    }

    local card = Creator.NewRoundFrame(12, "Squircle", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ThemeTag = {
            ImageColor3 = "ElementBackground",
            ImageTransparency = "ElementBackgroundTransparency",
        },
        Parent = parent,
    }, {
        Creator.New("UIPadding", {
            PaddingTop = UDim.new(0, 10),
            PaddingBottom = UDim.new(0, 10),
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12),
        }),
        Creator.New("UIListLayout", { FillDirection = Enum.FillDirection.Vertical, Padding = UDim.new(0, 6) }),
    })

    local topBar = Creator.New("Frame", {
        Size = UDim2.new(1, 0, 0, 22),
        BackgroundTransparency = 1,
        Parent = card,
    })

    Creator.New("TextLabel", {
        Size = UDim2.new(0.7, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = cfg.Title or "Console",
        TextSize = 15,
        FontFace = Font.new(Creator.Font, Enum.FontWeight.SemiBold),
        TextXAlignment = Enum.TextXAlignment.Left,
        ThemeTag = { TextColor3 = "ElementTitle" },
        Parent = topBar,
    })

    local clearBtn = Creator.NewRoundFrame(6, "Squircle", {
        Size = UDim2.new(0, 48, 0, 20),
        Position = UDim2.new(1, 0, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        ImageTransparency = 0.85,
        ThemeTag = { ImageColor3 = "Text" },
        Parent = topBar,
    }, {
        Creator.New("TextLabel", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "Clear",
            TextSize = 12,
            TextTransparency = 0.25,
            FontFace = Font.new(Creator.Font, Enum.FontWeight.Medium),
            ThemeTag = { TextColor3 = "Text" },
        }),
    }, true)

    local scroll = Creator.New("ScrollingFrame", {
        Size = UDim2.new(1, 0, 0, height),
        BackgroundTransparency = 0.35,
        ScrollBarThickness = 3,
        ScrollBarImageTransparency = 0.5,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ThemeTag = {
            BackgroundColor3 = "Background",
            ScrollBarImageColor3 = "Text",
        },
        Parent = card,
    }, {
        Creator.New("UICorner", { CornerRadius = UDim.new(0, 8) }),
        Creator.New("UIPadding", {
            PaddingTop = UDim.new(0, 6),
            PaddingBottom = UDim.new(0, 6),
            PaddingLeft = UDim.new(0, 8),
            PaddingRight = UDim.new(0, 8),
        }),
    })

    local logText = Creator.New("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Font = Enum.Font.Code,
        TextSize = cfg.TextSize or 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        RichText = true,
        Text = "",
        ThemeTag = { TextColor3 = "Text" },
        Parent = scroll,
    })

    local function Escape(s)
        return tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    end

    local function Refresh()
        logText.Text = table.concat(lines, "\n")
        task.defer(function()
            if scroll and scroll.Parent then
                scroll.CanvasPosition = Vector2.new(0, math.max(0, scroll.AbsoluteCanvasSize.Y))
            end
        end)
    end

    local api = { __type = "Console", Instance = card }
    function api:Log(msg, level)
        level = string.upper(tostring(level or "INFO"))
        local hex = levelHex[level] or levelHex.INFO
        local stamp = cfg.Timestamps ~= false and os.date("[%H:%M:%S] ") or ""
        table.insert(lines, string.format('<font color="#71717A">%s</font><font color="%s">[%s]</font> %s', stamp, hex, level, Escape(msg)))
        if #lines > maxLines then
            table.remove(lines, 1)
        end
        Refresh()
    end
    function api:Info(m) api:Log(m, "INFO") end
    function api:Warn(m) api:Log(m, "WARN") end
    function api:Error(m) api:Log(m, "ERR") end
    function api:Success(m) api:Log(m, "OK") end
    function api:Clear() table.clear(lines); logText.Text = "" end

    clearBtn.MouseButton1Click:Connect(function() api:Clear() end)

    for _, item in ipairs(cfg.Lines or {}) do
        if type(item) == "table" then
            api:Log(item[1], item[2])
        else
            api:Log(item, "INFO")
        end
    end

    return api
end

-- [6] LISTVIEW / TABLE
function Elements.Table(parent, cfg)
    cfg = cfg or {}
    local columns = cfg.Columns or { "text 1", "text 2", "text 3" }
    local rows = cfg.Rows or {}
    local colCount = math.max(#columns, 1)

    local card = Creator.NewRoundFrame(12, "Squircle", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ThemeTag = {
            ImageColor3 = "ElementBackground",
            ImageTransparency = "ElementBackgroundTransparency",
        },
        Parent = parent,
    }, {
        Creator.New("UIPadding", {
            PaddingTop = UDim.new(0, 12),
            PaddingBottom = UDim.new(0, 12),
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12),
        }),
        Creator.New("UIListLayout", { FillDirection = Enum.FillDirection.Vertical, Padding = UDim.new(0, 6) }),
    })

    local headerRow = Creator.New("Frame", {
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundTransparency = 1,
        LayoutOrder = 1,
        Parent = card,
    })

    for i, col in ipairs(columns) do
        Creator.New("TextLabel", {
            Size = UDim2.new(1 / colCount, -4, 1, 0),
            Position = UDim2.new((i - 1) / colCount, 4, 0, 0),
            BackgroundTransparency = 1,
            Text = tostring(col),
            TextSize = 14,
            FontFace = Font.new(Creator.Font, Enum.FontWeight.Bold),
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ThemeTag = { TextColor3 = "ElementTitle" },
            Parent = headerRow,
        })
    end

    Creator.New("Frame", {
        Size = UDim2.new(1, 0, 0, 1),
        BackgroundTransparency = 0.85,
        LayoutOrder = 2,
        ThemeTag = { BackgroundColor3 = "Text" },
        Parent = card,
    })

    local rowsContainer = Creator.New("ScrollingFrame", {
        Size = UDim2.new(1, 0, 0, cfg.Height or 0),
        AutomaticSize = cfg.Height and Enum.AutomaticSize.None or Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = cfg.Height and 3 or 0,
        ScrollBarImageTransparency = 0.5,
        BackgroundTransparency = 1,
        LayoutOrder = 3,
        ThemeTag = { ScrollBarImageColor3 = "Text" },
        Parent = card,
    }, {
        Creator.New("UIListLayout", { FillDirection = Enum.FillDirection.Vertical, Padding = UDim.new(0, 3) }),
    })

    local function Render()
        for _, ch in ipairs(rowsContainer:GetChildren()) do
            if ch:IsA("TextButton") then ch:Destroy() end
        end
        for rIdx, rowData in ipairs(rows) do
            local rBtn = Creator.New("TextButton", {
                Size = UDim2.new(1, 0, 0, 24),
                BackgroundTransparency = (rIdx % 2 == 0) and 0.95 or 1,
                Text = "",
                LayoutOrder = rIdx,
                ThemeTag = { BackgroundColor3 = "Text" },
                Parent = rowsContainer,
            }, {
                Creator.New("UICorner", { CornerRadius = UDim.new(0, 6) }),
            })

            for cIdx = 1, colCount do
                Creator.New("TextLabel", {
                    Size = UDim2.new(1 / colCount, -4, 1, 0),
                    Position = UDim2.new((cIdx - 1) / colCount, 4, 0, 0),
                    BackgroundTransparency = 1,
                    Text = tostring(rowData[cIdx] or ""),
                    TextSize = 13,
                    TextTransparency = 0.25,
                    FontFace = Font.new(Creator.Font, Enum.FontWeight.Medium),
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    ThemeTag = { TextColor3 = "Text" },
                    Parent = rBtn,
                })
            end

            rBtn.MouseButton1Click:Connect(function()
                Creator.SafeCallback(cfg.OnRowClick, rIdx, rowData)
            end)
        end
    end

    Render()

    local api = { __type = "Table", Instance = card }
    function api:SetRows(newRows) rows = newRows or {}; Render() end
    function api:AddRow(r) table.insert(rows, r); Render() end
    function api:Clear() table.clear(rows); Render() end
    return api
end

-- [7] CHART (Line Graph & Bar Graph)
function Elements.Chart(parent, cfg)
    cfg = cfg or {}
    local chartType = cfg.Type or "Line" -- "Line" atau "Bar"
    local data = cfg.Data or { 25, 45, 30, 75, 50, 90, 65 }
    local maxPoints = cfg.MaxPoints or 24
    local chartHeight = cfg.Height or 90
    local customColor = cfg.Color

    local card = Creator.NewRoundFrame(12, "Squircle", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ThemeTag = {
            ImageColor3 = "ElementBackground",
            ImageTransparency = "ElementBackgroundTransparency",
        },
        Parent = parent,
    }, {
        Creator.New("UIPadding", {
            PaddingTop = UDim.new(0, 12),
            PaddingBottom = UDim.new(0, 12),
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12),
        }),
        Creator.New("UIListLayout", { FillDirection = Enum.FillDirection.Vertical, Padding = UDim.new(0, 8) }),
    })

    local header = Creator.New("Frame", {
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundTransparency = 1,
        Parent = card,
    })

    Creator.New("TextLabel", {
        Size = UDim2.new(0.6, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = cfg.Title or "Chart",
        TextSize = 15,
        FontFace = Font.new(Creator.Font, Enum.FontWeight.SemiBold),
        TextXAlignment = Enum.TextXAlignment.Left,
        ThemeTag = { TextColor3 = "ElementTitle" },
        Parent = header,
    })

    local valueLabel = Creator.New("TextLabel", {
        Size = UDim2.new(0.4, 0, 1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        AnchorPoint = Vector2.new(1, 0),
        BackgroundTransparency = 1,
        Text = cfg.ValueText or tostring(data[#data] or 0),
        TextSize = 14,
        FontFace = Font.new(Creator.Font, Enum.FontWeight.SemiBold),
        TextXAlignment = Enum.TextXAlignment.Right,
        TextColor3 = customColor,
        ThemeTag = not customColor and { TextColor3 = "Primary" } or nil,
        Parent = header,
    })

    local canvas = Creator.New("Frame", {
        Size = UDim2.new(1, 0, 0, chartHeight),
        BackgroundTransparency = 0.4,
        ClipsDescendants = true,
        ThemeTag = { BackgroundColor3 = "Background" },
        Parent = card,
    }, {
        Creator.New("UICorner", { CornerRadius = UDim.new(0, 8) }),
        Creator.New("UIPadding", {
            PaddingTop = UDim.new(0, 8),
            PaddingBottom = UDim.new(0, 8),
            PaddingLeft = UDim.new(0, 8),
            PaddingRight = UDim.new(0, 8),
        }),
    })

    local plot = Creator.New("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Parent = canvas,
    })

    local function Render()
        plot:ClearAllChildren()
        if #data == 0 then return end

        local minV = cfg.Min or math.huge
        local maxV = cfg.Max or -math.huge
        if not cfg.Min or not cfg.Max then
            for _, v in ipairs(data) do
                if not cfg.Min and v < minV then minV = v end
                if not cfg.Max and v > maxV then maxV = v end
            end
        end
        if maxV == minV then maxV = minV + 1 end

        local w = plot.AbsoluteSize.X
        local h = plot.AbsoluteSize.Y
        if w <= 0 or h <= 0 then
            w, h = 260, chartHeight - 16
        end

        local count = #data
        if chartType == "Bar" then
            local gap = 4
            local barW = math.max((w - (gap * (count - 1))) / count, 3)
            for i, v in ipairs(data) do
                local norm = math.clamp((v - minV) / (maxV - minV), 0.04, 1)
                local barH = norm * h
                Creator.New("Frame", {
                    Size = UDim2.new(0, barW, 0, barH),
                    Position = UDim2.new(0, (i - 1) * (barW + gap), 1, 0),
                    AnchorPoint = Vector2.new(0, 1),
                    BackgroundTransparency = 0.2,
                    BackgroundColor3 = customColor,
                    ThemeTag = not customColor and { BackgroundColor3 = "Primary" } or nil,
                    Parent = plot,
                }, {
                    Creator.New("UICorner", { CornerRadius = UDim.new(0, 3) }),
                })
            end
        else
            local pts = {}
            local stepX = count > 1 and (w / (count - 1)) or w
            for i, v in ipairs(data) do
                local norm = math.clamp((v - minV) / (maxV - minV), 0, 1)
                local px = (i - 1) * stepX
                local py = (1 - norm) * h
                pts[i] = Vector2.new(px, py)

                Creator.New("Frame", {
                    Size = UDim2.new(0, 5, 0, 5),
                    Position = UDim2.new(0, px, 0, py),
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    ZIndex = 3,
                    ThemeTag = { BackgroundColor3 = "Text" },
                    Parent = plot,
                }, {
                    Creator.New("UICorner", { CornerRadius = UDim.new(1, 0) }),
                })
            end

            for i = 1, #pts - 1 do
                local p1, p2 = pts[i], pts[i + 1]
                local diff = p2 - p1
                local mid = (p1 + p2) / 2
                Creator.New("Frame", {
                    Size = UDim2.new(0, diff.Magnitude, 0, 2),
                    Position = UDim2.new(0, mid.X, 0, mid.Y),
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Rotation = math.deg(math.atan2(diff.Y, diff.X)),
                    BackgroundColor3 = customColor,
                    ThemeTag = not customColor and { BackgroundColor3 = "Primary" } or nil,
                    ZIndex = 2,
                    Parent = plot,
                })
            end
        end
    end

    plot:GetPropertyChangedSignal("AbsoluteSize"):Connect(Render)
    task.defer(Render)

    local api = { __type = "Chart", Instance = card }
    function api:SetData(newData, newValText)
        data = newData or {}
        if newValText ~= nil then
            valueLabel.Text = tostring(newValText)
        elseif #data > 0 then
            valueLabel.Text = tostring(data[#data])
        end
        Render()
    end
    function api:Push(val, newValText)
        table.insert(data, val)
        if #data > maxPoints then table.remove(data, 1) end
        valueLabel.Text = newValText ~= nil and tostring(newValText) or tostring(val)
        Render()
    end
    function api:SetType(t) chartType = t; Render() end
    return api
end

