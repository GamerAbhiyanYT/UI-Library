                    end)
                end
            end)

            AR.Conns[#AR.Conns + 1] = TS.TeleportInitFailed:Connect(function()
                if not AR.Enabled or not AR.Busy then return end
                if AR.Attempt == 1 then
                    AR.Attempt = 2
                    task.wait(1)
                    pcall(function() TS:Teleport(game.PlaceId, LocalPlayer) end)
                else
                    AR.Busy = false
                end
            end)
        end
    })
end


