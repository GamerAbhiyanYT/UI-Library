    function TeleportTo(target)
        root = getRoot()
        if not root then return end

        cf = typeof(target) == "Vector3" and CFrame.new(target) or target

        cancelTween()

        if TpStyle.Smooth then
            distance = (root.Position - cf.Position).Magnitude
            duration = math.max(distance / math.max(TpStyle.Speed, 1), 0.05)

            tween = TweenService:Create(
                root,
              TweenInfo.new(duration, Enum.EasingStyle.Linear),
              { CFrame = cf }
           )
           TpStyle.CurrentTween = tween
           tween.Completed:Connect(function()
                if TpStyle.CurrentTween == tween then
                    TpStyle.CurrentTween = nil
                end
                if root then
                    root.AssemblyLinearVelocity = Vector3.zero
                end
            end)
            tween:Play()
        else
            root.CFrame = cf
            root.AssemblyLinearVelocity = Vector3.zero
        end
    end

