        { type = "slider", key = "VerticalOffset", title = "Height Offset", desc = "Gap between the object and the text", min = 0, max = 40, step = 1 },
    }

    WE_StyleSpecs = {
        { type = "toggle", key = "ShowChams", title = "Show Chams", desc = "Highlight objects (Roblox shows max 31 highlights at once)" },
        { type = "dropdown", key = "DepthMode", title = "Depth Mode (Chams)", desc = "AlwaysOnTop = through walls, Occluded = hidden behind walls", values = { "AlwaysOnTop", "Occluded" } },
