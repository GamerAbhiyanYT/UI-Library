        coordNumbers = {}
        for num in string.gmatch(text, "[-+]?%d*%.?%d+") do
            coordValue = tonumber(num)
            if coordValue then
                table.insert(coordNumbers, coordValue)
            end
        end

        if #coordNumbers ~= 3 then
            return nil
        end

        return Vector3.new(coordNumbers[1], coordNumbers[2], coordNumbers[3])
    end

