function Creator.Gradient(keypoints, props)
    local colors = {}
    local trans = {}
    for k, v in pairs(keypoints) do
        local t = tonumber(k)
        if t then
            t = math.clamp(t / 100, 0, 1)
            table.insert(colors, ColorSequenceKeypoint.new(t, v.Color))
            table.insert(trans, NumberSequenceKeypoint.new(t, v.Transparency or 0))
        end
    end
    table.sort(colors, function(a, b) return a.Time < b.Time end)
    table.sort(trans, function(a, b) return a.Time < b.Time end)
    local out = {
        Color = ColorSequence.new(colors),
        Transparency = NumberSequence.new(trans),
    }
    if props then
        for k, v in pairs(props) do
            out[k] = v
        end
    end
    return out
end

function Creator.AddSignal(signal, callback)
    local conn = signal:Connect(callback)
    table.insert(Creator.Signals, conn)
    return conn
end

function Creator.DisconnectAll()
    for i = #Creator.Signals, 1, -1 do
        local conn = table.remove(Creator.Signals, i)
        if conn then
            pcall(function() conn:Disconnect() end)
        end
    end
end

function Creator.SafeCallback(fn, ...)
    if type(fn) ~= "function" then
        return
    end
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[WindUI Callback Error]: " .. tostring(err))
    end
end

function Creator.Tween(obj, duration, props, style, direction, repeatCount, reverses, delayTime)
    local info = TweenInfo.new(
        duration or 0.15,
        style or Enum.EasingStyle.Quint,
        direction or Enum.EasingDirection.Out,
        repeatCount or 0,
        reverses or false,
        delayTime or 0
    )
    return TweenService:Create(obj, info, props)
end

function Creator.GetThemeProperty(propName, themeTable, visited)
    visited = visited or {}
    if visited[propName] then
        return nil
    end
    visited[propName] = true
    themeTable = themeTable or Creator.Theme or Creator.Themes.Dark

    local function eval(tbl, key)
        local val = tbl and tbl[key]
        if val == nil then return nil end
        if type(val) == "string" then
            if val:sub(1, 1) == "#" then
                return Color3.fromHex(val)
            end
            return Creator.GetThemeProperty(val, themeTable, visited)
        end
        if type(val) == "function" then
            return val(themeTable)
        end
        return val
    end

    local res = eval(themeTable, propName)
    if res ~= nil then return res end

    local fb = Creator.ThemeFallbacks[propName]
    if fb ~= nil then
        if type(fb) == "string" then
            if fb:sub(1, 1) == "#" then
                return Color3.fromHex(fb)
            end
            return Creator.GetThemeProperty(fb, themeTable, visited)
        end
        return fb
    end

    if Creator.Themes.Dark and themeTable ~= Creator.Themes.Dark then
        visited[propName] = nil
        return eval(Creator.Themes.Dark, propName)
    end
    return nil
end

function Creator.ApplyThemeToObject(obj, props, animated, duration)
    if not obj or not obj.Parent then
        Creator.Objects[obj] = nil
        return
    end
    for prop, themeKey in pairs(props) do
        local val = Creator.GetThemeProperty(themeKey, Creator.Theme)
        if val ~= nil then
            if typeof(val) == "Color3" then
                local grad = obj:FindFirstChild("LibraryGradient")
                if grad then grad:Destroy() end
                if animated then
                    Creator.Tween(obj, duration or 0.15, { [prop] = val }):Play()
                else
                    pcall(function() obj[prop] = val end)
                end
            elseif type(val) == "table" and val.Color and val.Transparency then
                pcall(function() obj[prop] = Color3.new(1, 1, 1) end)
                local grad = obj:FindFirstChild("LibraryGradient")
                if not grad then
                    grad = Instance.new("UIGradient")
                    grad.Name = "LibraryGradient"
                    grad.Parent = obj
                end
                grad.Color = val.Color
                grad.Transparency = val.Transparency
                if val.Rotation then grad.Rotation = val.Rotation end
            elseif type(val) == "number" then
                if animated then
                    Creator.Tween(obj, duration or 0.15, { [prop] = val }):Play()
                else
                    pcall(function() obj[prop] = val end)
                end
            end
        end
    end
end

function Creator.AddThemeObject(obj, props, skipImmediate)
    if Creator.Objects[obj] then
        for k, v in pairs(props) do
            Creator.Objects[obj].Properties[k] = v
        end
    else
        Creator.Objects[obj] = { Object = obj, Properties = props }
    end
    if not skipImmediate then
        Creator.ApplyThemeToObject(obj, props, false)
    end
    return obj
end

function Creator.SetThemeTag(obj, props, duration)
    Creator.AddThemeObject(obj, props, true)
    Creator.ApplyThemeToObject(obj, props, true, duration)
end

function Creator.UpdateTheme(animated)
    for obj, entry in pairs(Creator.Objects) do
        if obj and obj.Parent then
            Creator.ApplyThemeToObject(obj, entry.Properties, animated, 0.2)
        else
            Creator.Objects[obj] = nil
        end
    end
end

function Creator.SetTheme(theme)
    local prev = Creator.Theme
    if type(theme) == "string" then
        theme = Creator.Themes[theme] or Creator.Themes.Dark
    end
    Creator.Theme = theme
    Creator.UpdateTheme(true)
    for _, cb in pairs(Creator.ThemeChangeCallbacks) do
        Creator.SafeCallback(cb, theme, prev)
    end
end

function Creator.OnThemeChange(cb)
    local id = HttpService:GenerateGUID(false)
    Creator.ThemeChangeCallbacks[id] = cb
    return {
        Disconnect = function()
            Creator.ThemeChangeCallbacks[id] = nil
        end
    }
end

function Creator.New(className, props, children)
    local inst = Instance.new(className)
    for k, v in pairs(Creator.DefaultProperties[className] or {}) do
        inst[k] = v
    end
    for k, v in pairs(props or {}) do
        if k ~= "ThemeTag" and k ~= "Parent" then
            inst[k] = v
        end
    end
    for _, child in ipairs(children or {}) do
        if typeof(child) == "Instance" then
            child.Parent = inst
        end
    end
    if props and props.Parent then
        inst.Parent = props.Parent
    end
    if props and props.ThemeTag then
        Creator.AddThemeObject(inst, props.ThemeTag)
    end
    if props and props.FontFace then
        table.insert(Creator.FontObjects, inst)
    end
    return inst
end

function Creator.NewRoundFrame(radius, shapeType, props, children, isButton)
    radius = radius or 10
    shapeType = shapeType or "Squircle"
    local resolvedName = ShapeAliases[shapeType] or shapeType
    local shapeData = Shapes[resolvedName] or Shapes.Squircle

    local img = Creator.New(isButton and "ImageButton" or "ImageLabel", {
        Image = shapeData.Image,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = shapeData.Rect,
        SliceScale = math.max(radius / shapeData.Radius, 0.0001),
        BackgroundTransparency = 1,
    })

    for k, v in pairs(props or {}) do
        if k ~= "ThemeTag" and k ~= "Parent" then
            img[k] = v
        end
    end
    for _, child in ipairs(children or {}) do
        if typeof(child) == "Instance" then
            child.Parent = img
        end
    end
    if props and props.Parent then
        img.Parent = props.Parent
    end
    if props and props.ThemeTag then
        Creator.AddThemeObject(img, props.ThemeTag)
    end

    local controller = {
        Radius = radius,
        Type = resolvedName,
    }
    function controller:SetRadius(r)
        self.Radius = r
        local s = Shapes[ShapeAliases[self.Type] or self.Type] or Shapes.Squircle
        img.SliceScale = math.max(r / s.Radius, 0.0001)
    end
    function controller:SetType(t)
        self.Type = t
        local s = Shapes[ShapeAliases[t] or t] or Shapes.Squircle
        img.Image = s.Image
        img.SliceCenter = s.Rect
        self:SetRadius(self.Radius)
    end

    return img, controller
end

function Creator.CreateIcon(iconName, size, themeColorTag)
    size = size or 18
    local resolved = Icons.Resolve(iconName)
    local holder = Creator.New("Frame", {
        Size = UDim2.new(0, size, 0, size),
        BackgroundTransparency = 1,
    })
    if resolved then
        Creator.New("ImageLabel", {
            Name = "ImageLabel",
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Image = resolved[1],
            ImageRectSize = resolved[2].ImageRectSize,
            ImageRectOffset = resolved[2].ImageRectPosition,
            ThemeTag = themeColorTag and { ImageColor3 = themeColorTag } or nil,
            Parent = holder,
        })
    end
    return holder
end

function Creator.Drag(targetFrame, dragHandles)
    dragHandles = dragHandles or { targetFrame }
    local dragging = false
    local dragStart, startPos
    local activeInput

    for _, handle in ipairs(dragHandles) do
        Creator.AddSignal(handle.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                activeInput = input
                dragStart = input.Position
                startPos = targetFrame.Position
            end
        end)
    end

    Creator.AddSignal(UserInputService.InputChanged, function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input == activeInput then
            local delta = input.Position - dragStart
            Creator.Tween(targetFrame, 0.04, {
                Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            }):Play()
        end
    end)

    Creator.AddSignal(UserInputService.InputEnded, function(input)
        if input == activeInput or input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            activeInput = nil
        end
    end)
end

