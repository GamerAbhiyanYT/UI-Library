                        if onScreen then
                            dat.Head.Visible = true
                            dat.Head.Position = Vector2.new(headPos.X, headPos.Y)
                            dat.Head.Radius = 15
                            dat.Head.Color = currentRainbowColor
                            dat.Head.Transparency = alpha
                            dat.Head.Thickness = SkeletonConfig.Thickness
                            dat.Head.Filled = false
                        else
                            dat.Head.Visible = false
                        end
                    else
                        dat.Head.Visible = false
                    end

                    for i, bone in ipairs(bones) do
                        local p1 = parts[bone[1]]
                        local p2 = parts[bone[2]]
                        
                        local line = dat.Lines[i]
                        if not line then
                            line = Drawing.new("Line")
                            line.Visible = false
                            dat.Lines[i] = line
