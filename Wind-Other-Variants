    Creator.New("TextLabel", {
        Size = UDim2.new(0, 14, 1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        AnchorPoint = Vector2.new(1, 0),
        BackgroundTransparency = 1,
        Text = "▾",
        TextSize = 13,
        ThemeTag = { TextColor3 = "Icon" },
        Parent = box,
    })

    local listHolder = Creator.New("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Visible = false,
        LayoutOrder = 20,
        Parent = base.TextHolder,
    }, {
        Creator.New("UIPadding", { PaddingTop = UDim.new(0, 8) }),
        Creator.New("UIListLayout", { FillDirection = Enum.FillDirection.Vertical, Padding = UDim.new(0, 4) }),
    })

    local function UpdateDisplay()
        if isMulti then
            selLabel.Text = (#selected > 0) and table.concat(selected, ", ") or "--"
        else
            selLabel.Text = selected ~= nil and tostring(selected) or "--"
        end
    end

    local function RebuildList()
        for _, ch in ipairs(listHolder:GetChildren()) do
            if ch:IsA("ImageButton") then ch:Destroy() end
        end
        for _, item in ipairs(values) do
            local label = type(item) == "table" and item.Title or tostring(item)
            local active = isMulti and (table.find(selected, label) ~= nil) or (selected == label)
            local optBtn = Creator.NewRoundFrame(8, "Squircle", {
                Size = UDim2.new(1, 0, 0, 28),
                ImageTransparency = active and 0.2 or 0.92,
                ThemeTag = { ImageColor3 = active and "Primary" or "Text" },
                Parent = listHolder,
            }, {
                Creator.New("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }),
                Creator.New("TextLabel", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = label,
                    TextSize = 13,
                    FontFace = Font.new(Creator.Font, Enum.FontWeight.Medium),
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextColor3 = active and Color3.new(1, 1, 1) or nil,
                    ThemeTag = not active and { TextColor3 = "Text" } or nil,
                }),
            }, true)

            optBtn.MouseButton1Click:Connect(function()
                if isMulti then
                    local idx = table.find(selected, label)
                    if idx then
                        if cfg.AllowNone or #selected > 1 then
                            table.remove(selected, idx)
                        end
                    else
                        table.insert(selected, label)
                    end
                else
                    selected = label
                    opened = false
                    listHolder.Visible = false
                end
                UpdateDisplay()
                RebuildList()
                Creator.SafeCallback(cfg.Callback, selected)
            end)
        end
    end

    UpdateDisplay()
    RebuildList()

    base.Card.MouseButton1Click:Connect(function()
        opened = not opened
        listHolder.Visible = opened
    end)

    local api = { __type = "Dropdown", Value = selected, Instance = base.Card }
    function api:Select(val)
        selected = val
        api.Value = selected
        UpdateDisplay()
        RebuildList()
        Creator.SafeCallback(cfg.Callback, selected)
    end
    function api:Refresh(newVals)
        values = newVals or {}
        RebuildList()
    end
    function api:Get() return selected end

    ConfigManager:Register(cfg.Flag, api)
    return api
end

