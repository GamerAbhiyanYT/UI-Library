                        SkeletonDrawings[player] = dat
                    end

                    local isR15 = hum.RigType == Enum.HumanoidRigType.R15
                    local bones = isR15 and R15_Bones or R6_Bones
                    local parts = skeletonGetParts(char, bones, now)
                    
                    local headPart = parts["Head"]
                    if SkeletonConfig.HeadCircle and headPart then
