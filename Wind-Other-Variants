end

--[[=======[ Tracker > Tracer ]== ]]
do
    playerTracer = TabHandles.Tracer:Section({ 
        Title = "Visual Tracker",
        Box = true,
        TextXAlignment = "Left",
        TextSize = 17,
        Opened = true,
    })
    
    ESPConfig = {
        Enabled = false,
        CircleEnabled = true,
        TargetPart = "Torso",
        Origin = "Bottom Center Screen",
        Color = Color3.fromHex("#FF0000"),
        Rainbow = false,
        Transparency = 0,
        Thickness = 2
    }
    
    TracerESP = (function()
        Vector2new = Vector2.new
        Color3fromHSV = Color3.fromHSV
        Color3fromRGB = Color3.fromRGB
        DrawingNew = Drawing and Drawing.new
        pairs, tick = pairs, tick
    
        ORIGINS = {
            ["Top Left Screen"]      = { 0,   0   },
            ["Top Center Screen"]    = { 0.5, 0   },
            ["Top Right Screen"]     = { 1,   0   },
            ["Middle Left Screen"]   = { 0,   0.5 },
            ["Center Screen"]        = { 0.5, 0.5 },
            ["Middle Right Screen"]  = { 1,   0.5 },
            ["Bottom Left Screen"]   = { 0,   1   },
            ["Bottom Center Screen"] = { 0.5, 1   },
            ["Bottom Right Screen"]  = { 1,   1   },
        }
    
        PART_CANDIDATES = {
            ["Head"]      = { "Head" },
            ["Torso"]     = { "HumanoidRootPart", "Torso", "UpperTorso" },
            ["Left Arm"]  = { "LeftHand", "LeftLowerArm", "Left Arm" },
            ["Right Arm"] = { "RightHand", "RightLowerArm", "Right Arm" },
            ["Left Leg"]  = { "LeftFoot", "LeftLowerLeg", "Left Leg" },
            ["Right Leg"] = { "RightFoot", "RightLowerLeg", "Right Leg" },
        }
    
        BLACK = Color3fromRGB(0, 0, 0)
        local tracers = {}
        local connections = {}
        local wasEnabled = false
        local warned = false
    
        function getOriginPosition(viewport)
            f = ORIGINS[ESPConfig.Origin] or ORIGINS["Bottom Center Screen"]
            return Vector2new(viewport.X * f[1], viewport.Y * f[2])
        end
    
        function getTargetPart(t, character)
            key = ESPConfig.TargetPart
            part = t.Part
            if part and part.Parent and t.PartChar == character and t.PartKey == key then
                return part
            end
    
            list = PART_CANDIDATES[key] or PART_CANDIDATES.Torso
            part = nil
            for i = 1, #list do
                part = character:FindFirstChild(list[i])
                if part then break end
            end
    
            t.Part, t.PartChar, t.PartKey = part, character, key
            return part
        end
    
        function getHumanoid(t, character)
            hum = t.Humanoid
            if hum and hum.Parent and t.HumChar == character then
                return hum
            end
            hum = character:FindFirstChildOfClass("Humanoid")
            t.Humanoid, t.HumChar = hum, character
            return hum
        end
    
        function setLineShown(t, state)
            if t.LineShown ~= state then
                t.LineShown = state
                t.Line.Visible = state
            end
        end
    
        function setCircleShown(t, state)
            if t.CircleShown ~= state then
                t.CircleShown = state
                t.Outer.Visible = state
                t.Inner.Visible = state
            end
        end
    
        function hide(t)
            setLineShown(t, false)
            setCircleShown(t, false)
        end
    
        function createTracer(player)
            if not DrawingNew or tracers[player] or player == LocalPlayer then return end
    
            line = DrawingNew("Line")
            line.Visible = false
    
            outer = DrawingNew("Circle")
            outer.Visible = false
            outer.Filled = false
            outer.Radius = 16
            outer.Thickness = 2
    
            inner = DrawingNew("Circle")
            inner.Visible = false
            inner.Filled = true
            inner.Radius = 12
            inner.Color = BLACK
            inner.Transparency = 1
    
            tracers[player] = {
                Line = line, Outer = outer, Inner = inner,
                LineShown = false, CircleShown = false,
            }
        end
    
        function removeTracer(player)
            t = tracers[player]
            if not t then return end
            t.Line:Remove()
            t.Outer:Remove()
            t.Inner:Remove()
            tracers[player] = nil
        end
    
        function hideAll()
            for _, t in pairs(tracers) do
                hide(t)
            end
        end
    
        function removeAll()
            for player in pairs(tracers) do
                removeTracer(player)
            end
        end
    
        function createAll()
            for _, player in ipairs(Players:GetPlayers()) do
                createTracer(player)
            end
        end
    
        createAll()
        connections[#connections + 1] = Players.PlayerAdded:Connect(createTracer)
        connections[#connections + 1] = Players.PlayerRemoving:Connect(removeTracer)
    
        connections[#connections + 1] = RunService.RenderStepped:Connect(function()
            if not ESPConfig.Enabled then
                if wasEnabled then
                    wasEnabled = false
                    hideAll()
                end
                return
            end
            wasEnabled = true
    
            if not DrawingNew then
                if not warned then
                    warned = true
                    WindUI:Notify({
                        Title = "Not Supported",
                        Content = "Your executor has no Drawing library, Tracer ESP can't render",
                        Icon = "alert-triangle",
                        Duration = 4,
                    })
                end
                return
            end
    
            camera = Workspace.CurrentCamera
            if not camera then return end
    
            color = ESPConfig.Color
            if ESPConfig.Rainbow then
                color = Color3fromHSV(tick() % 5 / 5, 1, 1)
            end
            alpha = 1 - ESPConfig.Transparency
            thickness = ESPConfig.Thickness
            showCircle = ESPConfig.CircleEnabled
            origin = getOriginPosition(camera.ViewportSize)
    
            for player, t in pairs(tracers) do
                character = player.Character
                humanoid = character and getHumanoid(t, character)
                part = humanoid and humanoid.Health > 0 and getTargetPart(t, character)
    
                if part then
                    pos, onScreen = camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        point = Vector2new(pos.X, pos.Y)
    
                        line = t.Line
                        line.From = origin
                        line.To = point
                        line.Color = color
                        line.Transparency = alpha
                        line.Thickness = thickness
                        setLineShown(t, true)
    
                        if showCircle then
                            outer = t.Outer
                            outer.Position = point
                            outer.Color = color
                            outer.Transparency = alpha
                            t.Inner.Position = point
                            setCircleShown(t, true)
                        else
                            setCircleShown(t, false)
                        end
                    else
                        hide(t)
                    end
                else
                    hide(t)
                end
            end
        end)
    
        return {
            Reload = function()
                removeAll()
                createAll()
                wasEnabled = false
            end,
            Destroy = function()
                for i = 1, #connections do
                    connections[i]:Disconnect()
                end
                table.clear(connections)
                removeAll()
            end,
        }
    end)()
    
    tracerToggle = playerTracer:Toggle({
        Title = "Enable Tracer",
        Desc = "Shows the line to the player",
        Value = ESPConfig.Enabled,
        Callback = function(state)
            ESPConfig.Enabled = state
        end
    })
    
    tracerCircleToggle = playerTracer:Toggle({
        Title = "Enable Donut Circle",
        Desc = "Displays a hollow donut-shaped indicator over the targeted body part",
        Value = ESPConfig.CircleEnabled,
        Callback = function(state)
            ESPConfig.CircleEnabled = state
        end
    })
    
    playerTracer:Divider()
    
    tracerTarget = playerTracer:Dropdown({
        Title = "Tracer body target",
        Desc = "targeting Tracer to a humanoid body part",
        Values = { "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg" },
        Value = ESPConfig.TargetPart,
        Callback = function(option) 
            ESPConfig.TargetPart = option
        end
    })
    
    originTracer = playerTracer:Dropdown({
        Title = "Origin Line",
        Desc = "customize the tracer line starting position on screen",
        Values = { "Top Left Screen", "Top Center Screen", "Top Right Screen", "Middle Left Screen", "Center Screen", "Middle Right Screen", "Bottom Left Screen", "Bottom Center Screen", "Bottom Right Screen" },
        Value = ESPConfig.Origin,
        Callback = function(option) 
            ESPConfig.Origin = option
        end
    })
    
    playerTracer:Divider()
    
    tracerColorpicker = playerTracer:Colorpicker({
        Title = "Line & Circle Color",
        Desc = "Customize the primary color for both tracer lines and target indicators",
        Default = ESPConfig.Color,
        Transparency = 0,
        Locked = false,
        Callback = function(color)
            ESPConfig.Color = color
        end
    })
    
    tracerRainbowToggle = playerTracer:Toggle({
        Title = "RGB Color",
        Desc = "Enables a smooth rainbow color transition effect for lines and targets",
        Value = ESPConfig.Rainbow,
        Callback = function(state)
            ESPConfig.Rainbow = state
        end
    })
    
    playerTracer:Divider()
    
    lineTracerParant = playerTracer:Slider({
        Title = "Line Transparency",
        Desc = "Adjust the transparency level of the tracer lines and target indicators",
        Step = 0.1,
        Value = {
            Min = 0,
            Max = 1,
            Default = ESPConfig.Transparency, -- 0 = solid/opaque, 1 = fully transparent
        },
        Callback = function(value)
            ESPConfig.Transparency = value
        end
    })
    
    lineTracerThick = playerTracer:Slider({
        Title = "Line Thickness",
        Desc = "Set the pixel thickness of the rendered tracer lines",
        Step = 1,
        Value = {
            Min = 1,
            Max = 10,
            Default = ESPConfig.Thickness,
        },
        Callback = function(value)
            ESPConfig.Thickness = value
        end
    })
    
    tracerManagement = TabHandles.Tracer:Section({
        Title = "Preset Management",
        Box = true,
        TextXAlignment = "Left",
        TextSize = 17,
        Opened = true,
    })
    
    tracerManagement:Button({
        Title = "Reset to Default",
        Desc = "Restore Tracer ESP settings to default values",
        Callback = function()
            ESPConfig.Enabled = false
            ESPConfig.CircleEnabled = true
            ESPConfig.TargetPart = "Torso"
            ESPConfig.Origin = "Bottom Center Screen"
            ESPConfig.Color = Color3.fromHex("#FF0000")
            ESPConfig.Rainbow = false
            ESPConfig.Transparency = 0
            ESPConfig.Thickness = 2
    
            WindUI:Notify({
                Title = "Success!",
                Content = "Tracer settings restored to default",
                Icon = "check",
                Duration = 2
            })
        end
    })
    
    tracerManagement:Button({
        Title = "Reload Settings",
        Desc = "Manually refresh drawing states for active players",
        Callback = function()
            TracerESP.Reload()
    
            WindUI:Notify({
                Title = "Success!",
                Content = "Tracer ESP successfully refreshed",
                Icon = "check",
                Duration = 2
            })
        end
    })

end
    
