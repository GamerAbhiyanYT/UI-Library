    function SecProt.OnHealth(newHealth, char, root, hum, A)
        A = SecProt.Fall
        char, root, hum = SecProt.Parts()
        if hum and A.Enabled and (tick() - A.LastFallTick) < 0.6
            and A.LastHealth and newHealth < A.LastHealth then
            hum.Health = A.LastHealth
        else
            A.LastHealth = newHealth
        end
    end
    
    function SecProt.HookHealth(hum, A)
        A = SecProt.Fall
        if A.HealthConn then A.HealthConn:Disconnect() A.HealthConn = nil end
        A.LastHealth = hum.Health
        A.HealthConn = hum.HealthChanged:Connect(SecProt.OnHealth)
    end
    
    function SecProt.FallStep(dt, char, root, vel, A)
        A = SecProt.Fall
        char, root = SecProt.Parts()
        if not root then return end
        vel = root.AssemblyLinearVelocity
        if vel.Y < -40 then A.LastFallTick = tick() end
        if vel.Y < -A.MaxFallSpeed then
            A.Params.FilterDescendantsInstances = { char }
            if workspace:Raycast(root.Position, Vector3.new(0, -A.GroundRange, 0), A.Params) then
                root.AssemblyLinearVelocity = Vector3.new(vel.X, -A.MaxFallSpeed, vel.Z)
            end
        end
    end
    
