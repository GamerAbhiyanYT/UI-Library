function gradient(text, startColor, endColor)
    if #text == 0 then
        return ""
    end
    
    result = ""
    for i = 1, #text do
        t = (i - 1) / math.max(1, (#text - 1))
        r = math.floor((startColor.R + (endColor.R - startColor.R) * t) * 255)
        g = math.floor((startColor.G + (endColor.G - startColor.G) * t) * 255)
        b = math.floor((startColor.B + (endColor.B - startColor.B) * t) * 255)
        result = result .. string.format('<font color="rgb(%d,%d,%d)">%s</font>', r, g, b, text:sub(i, i))
    end
    return result
end

