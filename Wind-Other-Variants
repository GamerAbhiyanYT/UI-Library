    Noclip = {
        Enabled = false,
        Conn = nil,
        Changed = {},
    }

    function restore()
        for part in pairs(Noclip.Changed) do
            if part and part.Parent then
                part.CanCollide = true
            end
        end
        table.clear(Noclip.Changed)
    end

    function setNoclip(state)
        Noclip.Enabled = state

        if Noclip.Conn then
            Noclip.Conn:Disconnect()
            Noclip.Conn = nil
        end

        if Noclip.DescConn then
            Noclip.DescConn:Disconnect()
            Noclip.DescConn = nil
        end
        Noclip.Char = nil

        if not state then
            restore()
            return
        end

        -- [FIX LAG/FREEZE] Dulu char:GetDescendants() dipanggil di SETIAP physics step (60x+/detik),
        -- membuat tabel baru terus-menerus -> garbage collection spike = stutter/freeze.
        -- Sekarang daftar BasePart di-cache dan hanya dibangun ulang saat karakter berubah / ada part baru.
        Noclip.Parts = {}
        Noclip.Dirty = true

        Noclip.Conn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end

            if Noclip.Char ~= char then
                Noclip.Char = char
                Noclip.Dirty = true
                if Noclip.DescConn then Noclip.DescConn:Disconnect() end
                Noclip.DescConn = char.DescendantAdded:Connect(function()
                    Noclip.Dirty = true
                end)
            end

            local parts = Noclip.Parts
            if Noclip.Dirty then
                Noclip.Dirty = false
                table.clear(parts)
                for _, d in ipairs(char:GetDescendants()) do
                    if d:IsA("BasePart") then
                        parts[#parts + 1] = d
                    end
                end
            end

            for i = 1, #parts do
                local part = parts[i]
                if part.CanCollide then
                    Noclip.Changed[part] = true
                    part.CanCollide = false
                end
            end
        end)
    end

    LocalPlayer.CharacterAdded:Connect(function()
