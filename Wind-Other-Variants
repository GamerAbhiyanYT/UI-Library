-- 5. CONFIG MANAGER
-- ============================================================================
local ConfigManager = {
    Folder = nil,
    Path = nil,
    Configs = {},
    Flags = {},
}

function ConfigManager:Init(folderName)
    if not folderName or RunService:IsStudio() or not writefile then
        return false
    end
    self.Folder = folderName
    self.Path = "WindUI/" .. tostring(folderName) .. "/config/"
    if isfolder and not isfolder(self.Path) and makefolder then
        makefolder(self.Path)
    end
    return true
end

function ConfigManager:Register(flag, element)
    if flag and flag ~= "" then
        self.Flags[flag] = element
    end
end

function ConfigManager:Save(name)
    if not self.Path or not writefile then return false end
    local payload = { __version = 1.666, __elements = {} }
    for flag, el in pairs(self.Flags) do
        if el.__type == "Colorpicker" and el.Default then
            payload.__elements[flag] = { __type = "Colorpicker", value = el.Default:ToHex(), transparency = el.Transparency }
        elseif el.__type == "Slider" and el.Value then
            payload.__elements[flag] = { __type = "Slider", value = el.Value.Default }
        elseif el.Get then
            payload.__elements[flag] = { __type = el.__type, value = el:Get() }
        elseif el.Value ~= nil then
            payload.__elements[flag] = { __type = el.__type, value = el.Value }
        end
    end
    writefile(self.Path .. name .. ".json", HttpService:JSONEncode(payload))
    return true
end

function ConfigManager:Load(name)
    if not self.Path or not isfile or not readfile then return false end
    local file = self.Path .. name .. ".json"
    if not isfile(file) then return false end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(file)) end)
    if not ok or type(data) ~= "table" then return false end
    for flag, saved in pairs(data.__elements or {}) do
        local el = self.Flags[flag]
        if el and saved.value ~= nil then
            if el.__type == "Colorpicker" and el.Update then
                el:Update(Color3.fromHex(saved.value), saved.transparency)
            elseif el.__type == "Dropdown" and el.Select then
                el:Select(saved.value)
            elseif el.Set then
                el:Set(saved.value)
            end
        end
    end
    return true
end

