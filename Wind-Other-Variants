                        end
                    end
                end
    
                table.insert(FC.Conns, FC.UIS.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton2 then
                        FC.RightHeld = true
                        FC.UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
                    end
                end))
    
                table.insert(FC.Conns, FC.UIS.InputEnded:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton2 then
                        FC.RightHeld = false
                        FC.UIS.MouseBehavior = Enum.MouseBehavior.Default
                    end
                end))
    
                table.insert(FC.Conns, FC.UIS.InputChanged:Connect(function(i, processed)
