        fbHum = fbChar and fbChar:FindFirstChildOfClass("Humanoid")
        if fbHum and fbOriginalSpeed then
            fbHum.WalkSpeed = fbOriginalSpeed
        end
        fbOriginalSpeed = nil
    end

    function fbStop()
        fbEnabled = false
        fbLastPos = nil

        if fbConn then
            fbConn:Disconnect()
            fbConn = nil
        end

        fbRestoreSpeed()

        fbChar = LocalPlayer.Character
        fbHum = fbChar and fbChar:FindFirstChildOfClass("Humanoid")
        fbRoot = fbChar and fbChar:FindFirstChild("HumanoidRootPart")
        if fbHum and fbRoot then
            fbHum:MoveTo(fbRoot.Position)
        end
    end

    function fbStep()
        fbNow = os.clock()
        if fbNow - fbLastMove < FB_INTERVAL then return end
        fbLastMove = fbNow

        if not fbTarget or fbTarget.Parent ~= PlayersService then return end

        fbMyChar = LocalPlayer.Character
        fbMyHum = fbMyChar and fbMyChar:FindFirstChildOfClass("Humanoid")
        fbMyRoot = fbMyChar and fbMyChar:FindFirstChild("HumanoidRootPart")
        fbTargetChar = fbTarget.Character
        fbTargetRoot = fbTargetChar and fbTargetChar:FindFirstChild("HumanoidRootPart")

        if not (fbMyHum and fbMyRoot and fbTargetRoot) then return end
        if fbMyHum.Health <= 0 then return end

        if not fbOriginalSpeed then
            fbOriginalSpeed = fbMyHum.WalkSpeed
        end
        fbMyHum.WalkSpeed = fbSpeed

        fbGap = math.max(fbDistance, FB_MIN_DISTANCE)
        fbGoal = (fbTargetRoot.CFrame * CFrame.new(0, 0, fbGap)).Position
        fbToGoal = (fbGoal - fbMyRoot.Position).Magnitude

        if fbToGoal > 2 then
            fbMyHum:MoveTo(fbGoal)

            if fbNow - fbLastCheck >= 0.6 then
                fbLastCheck = fbNow
                if fbLastPos and (fbMyRoot.Position - fbLastPos).Magnitude < 0.5 and fbToGoal > 4 then
                    fbMyHum.Jump = true
                end
                fbLastPos = fbMyRoot.Position
            end
        else
            fbMyHum:MoveTo(fbMyRoot.Position)
            fbLastPos = nil
        end
    end

    function fbStart()
        if fbConn then
            fbConn:Disconnect()
            fbConn = nil
        end
        fbEnabled = true
        fbLastMove = 0
        fbLastCheck = 0
        fbLastPos = nil
        fbOriginalSpeed = nil
