-- 2. ICONS MODULE (Lucide & Direct Asset Resolver)
-- ============================================================================
local Icons = {
    IconsType = "lucide",
    Icons = {},
    External = nil,
}

do
    local ok, loaded = pcall(function()
        local url = "https://raw.githubusercontent.com/Footagesus/Icons/main/Main-v2.lua"
        local body = game.HttpGet and game:HttpGet(url) or HttpService:GetAsync(url)
        return loadstring(body)()
    end)
    if ok and type(loaded) == "table" then
        Icons.External = loaded
        if loaded.SetIconsType then
            loaded.SetIconsType("lucide")
        end
    end
end

function Icons.AddIcons(packName, iconsData)
    if Icons.External and Icons.External.AddIcons then
        Icons.External.AddIcons(packName, iconsData)
    end
    Icons.Icons[packName] = Icons.Icons[packName] or { Icons = {} }
    for name, data in pairs(iconsData) do
        if type(data) == "number" then
            data = "rbxassetid://" .. tostring(data)
        end
        if type(data) == "string" then
            Icons.Icons[packName].Icons[name] = {
                Image = data,
                ImageRectSize = Vector2.new(0, 0),
                ImageRectPosition = Vector2.new(0, 0),
            }
        elseif type(data) == "table" and data.Image then
            Icons.Icons[packName].Icons[name] = {
                Image = type(data.Image) == "number" and ("rbxassetid://" .. tostring(data.Image)) or data.Image,
                ImageRectSize = data.ImageRectSize or Vector2.new(0, 0),
                ImageRectPosition = data.ImageRectPosition or Vector2.new(0, 0),
            }
        end
    end
end

function Icons.Resolve(iconName)
    if not iconName or iconName == "" then
        return nil
    end
    if type(iconName) == "number" then
        return { "rbxassetid://" .. tostring(iconName), { ImageRectSize = Vector2.new(0, 0), ImageRectPosition = Vector2.new(0, 0) } }
    end
    if type(iconName) == "string" and (iconName:match("^rbxassetid://") or iconName:match("^rbxthumb://")) then
        return { iconName, { ImageRectSize = Vector2.new(0, 0), ImageRectPosition = Vector2.new(0, 0) } }
    end
    if Icons.External and Icons.External.Icon2 then
        local ok, res = pcall(Icons.External.Icon2, iconName, nil, true)
        if ok and res then
            if type(res) == "string" then
                return { res, { ImageRectSize = Vector2.new(0, 0), ImageRectPosition = Vector2.new(0, 0) } }
            elseif type(res) == "table" and res[1] then
                return res
            end
        end
    end
    local pack, name = iconName:match("^([^:]+):(.+)$")
    pack = pack or Icons.IconsType
    name = name or iconName
    local p = Icons.Icons[pack]
    if p and p.Icons and p.Icons[name] then
        local entry = p.Icons[name]
        return { entry.Image, entry }
    end
    return nil
end

