            for key in pairs(AN.Ids) do
                AN.Ids[key] = ""
                pcall(function() AN.UI[key]:Set("") end) -- clear the text box too
            end

            char = LocalPlayer.Character
            saved = char and AN.Orig[char]
            if saved then
                for anim, original in pairs(saved) do
                    if anim and anim.Parent then
                        anim.AnimationId = original
                    end
                end
                AN.Orig[char] = nil
                AN.Refresh(char)
            end

            WindUI:Notify({ Title = "Success", Content = "Animations back to default", Icon = "check", Duration = 2 })
        end
