-- [D] SLIDER (Standard & Stepper = true: [-]========O==[+])
function Elements.Slider(parent, cfg)
    cfg = cfg or {}
    local valCfg = type(cfg.Value) == "table" and cfg.Value or {}
    local minVal = valCfg.Min or cfg.Min or 0
    local maxVal = valCfg.Max or cfg.Max or 100
    local step = cfg.Step or 1
    local current = math.clamp(valCfg.Default or cfg.Default or minVal, minVal, maxVal)
    local isStepper = cfg.Stepper == true
    local isFloat = step % 1 ~= 0

    local function Snap(v)
        local snapped = minVal + math.floor((v - minVal) / step + 0.5) * step
        snapped = math.clamp(snapped, minVal, maxVal)
        return isFloat and tonumber(string.format("%.2f", snapped)) or math.floor(snapped + 0.5)
    end

    local controlWidth = isStepper and 215 or 165
    local base = CreateElementCard(parent, {
        Type = "Slider",
        Title = cfg.Title or "Slider",
        Desc = cfg.Desc,
        Icon = cfg.Icon,
        RightOffset = controlWidth + 10,
    })

    local holder = Creator.New("Frame", {
        Size = UDim2.new(0, controlWidth, 0, 26),
        Position = UDim2.new(1, 0, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundTransparency = 1,
        Parent = base.Inner,
    })

    local valueBox = Creator.New("TextBox", {
        Size = UDim2.new(0, 38, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(current),
        TextSize = 14,
        TextTransparency = 0.25,
        FontFace = Font.new(Creator.Font, Enum.FontWeight.Medium),
        TextXAlignment = Enum.TextXAlignment.Right,
        ThemeTag = { TextColor3 = "Text" },
        Parent = holder,
    })

    local minusBtn, plusBtn
    if isStepper then
        local function MakeBtn(txt, xScale, xOff, anchorX)
            local btn = Creator.NewRoundFrame(6, "Squircle", {
                Size = UDim2.new(0, 22, 0, 22),
                Position = UDim2.new(xScale, xOff, 0.5, 0),
                AnchorPoint = Vector2.new(anchorX, 0.5),
                ImageTransparency = 0.85,
                ThemeTag = { ImageColor3 = "Text" },
                Parent = holder,
            }, {
                Creator.New("TextLabel", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = txt,
                    TextSize = 15,
                    FontFace = Font.new(Creator.Font, Enum.FontWeight.Bold),
                    ThemeTag = { TextColor3 = "Text" },
                }),
            }, true)
            return btn
        end
        minusBtn = MakeBtn("-", 0, 44, 0)
        plusBtn = MakeBtn("+", 1, 0, 1)
    end

    local trackLeft = isStepper and 72 or 46
    local trackRight = isStepper and 28 or 0

    local hitbox = Creator.New("TextButton", {
        Size = UDim2.new(1, -(trackLeft + trackRight), 0, 22),
        Position = UDim2.new(0, trackLeft, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundTransparency = 1,
        Text = "",
        Parent = holder,
    })

    local track = Creator.NewRoundFrame(99, "Squircle", {
        Size = UDim2.new(1, 0, 0, 5),
        Position = UDim2.new(0, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        ImageTransparency = 0.88,
        ThemeTag = { ImageColor3 = "Text" },
        Parent = hitbox,
    })

    local initRatio = (maxVal > minVal) and ((current - minVal) / (maxVal - minVal)) or 0
    local fill = Creator.NewRoundFrame(99, "Squircle", {
        Size = UDim2.new(initRatio, 0, 1, 0),
        ThemeTag = { ImageColor3 = "Slider" },
        Parent = track,
    }, {
        Creator.NewRoundFrame(99, "Squircle", {
            Size = UDim2.new(0, 14, 0, 14),
            Position = UDim2.new(1, 0, 0.5, 0),
            AnchorPoint = Vector2.new(0.5, 0.5),
            ThemeTag = { ImageColor3 = "SliderThumb" },
        }),
    })

    local api = {
        __type = "Slider",
        Value = { Min = minVal, Max = maxVal, Default = current },
        Instance = base.Card,
    }

    function api:Set(val, silent)
        local snapped = Snap(tonumber(val) or current)
        local ratio = (maxVal > minVal) and ((snapped - minVal) / (maxVal - minVal)) or 0
        Creator.Tween(fill, 0.06, { Size = UDim2.new(ratio, 0, 1, 0) }):Play()
        valueBox.Text = tostring(snapped)
        if snapped ~= current then
            current = snapped
            api.Value.Default = snapped
            if not silent then
                Creator.SafeCallback(cfg.Callback, snapped)
            end
        end
    end

    function api:Get()
        return current
    end

    local dragging = false
    local function UpdateFromX(x)
        local ratio = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        api:Set(minVal + ratio * (maxVal - minVal), false)
    end

    hitbox.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            UpdateFromX(inp.Position.X)
        end
    end)

    Creator.AddSignal(UserInputService.InputChanged, function(inp)
        if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
            UpdateFromX(inp.Position.X)
        end
    end)

    Creator.AddSignal(UserInputService.InputEnded, function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    valueBox.FocusLost:Connect(function()
        local num = tonumber(valueBox.Text)
        if num then
            api:Set(num, false)
        else
            valueBox.Text = tostring(current)
        end
    end)

    if isStepper and minusBtn and plusBtn then
        local function BindHold(btn, delta)
            local holding = false
            btn.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    holding = true
                    api:Set(current + delta, false)
                    task.spawn(function()
                        task.wait(0.35)
                        while holding do
                            api:Set(current + delta, false)
                            task.wait(0.06)
                        end
                    end)
                end
            end)
            btn.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    holding = false
                end
            end)
        end
        BindHold(minusBtn, -step)
        BindHold(plusBtn, step)
    end

    ConfigManager:Register(cfg.Flag, api)
    return api
end

