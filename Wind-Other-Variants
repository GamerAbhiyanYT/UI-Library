    SecAnimChanger:Button({
        Title = "Apply Animation",
        Desc = "Apply the animation IDs you entered to your character. Empty fields keep the default animation. Stays active after respawn.",
        Locked = false,
        -- char, ok, changed are not passed in; they act as scratch variables
        Callback = function(char, ok, changed)
            -- Applies every filled ID to the character's Animate script.
            AN.Run = function(target, animate, count, folder, anim)
                animate = target:WaitForChild("Animate", 10)
                if not animate then return 0 end

                AN.Orig[target] = AN.Orig[target] or {}
                count = 0

                for key, info in pairs(AN.Map) do
                    if AN.Ids[key] ~= "" then
                        folder = animate:WaitForChild(info[1], 5)
                        if folder then
                            for _, name in ipairs(info[2]) do
                                anim = folder:FindFirstChild(name)
                                if anim and anim:IsA("Animation") then
                                    if AN.Orig[target][anim] == nil then
                                        AN.Orig[target][anim] = anim.AnimationId -- remember default for Reset
                                    end
                                    anim.AnimationId = "rbxassetid://" .. AN.Ids[key]
                                    count = count + 1
                                end
                            end
                        end
                    end
                end

                if count > 0 then AN.Refresh(target) end
                return count
            end

            -- re-apply automatically every time you respawn
            if not AN.Conn then
                AN.Conn = LocalPlayer.CharacterAdded:Connect(function(newChar)
                    task.wait(0.5)
                    pcall(AN.Run, newChar)
                end)
            end

            char = LocalPlayer.Character
            if not char then
                WindUI:Notify({ Title = "Error", Content = "Cannot find your character.", Icon = "alert-triangle", Duration = 2 })
                return
            end

            ok, changed = pcall(AN.Run, char)
            if ok and changed and changed > 0 then
                WindUI:Notify({ Title = "Success", Content = "Animation applied (" .. changed .. " slot(s) changed)", Icon = "check", Duration = 2 })
            elseif ok and changed == 0 then
                WindUI:Notify({ Title = "Nothing changed", Content = "Enter at least one animation ID, or this game has no standard Animate script.", Icon = "info", Duration = 3 })
            else
                WindUI:Notify({ Title = "Error", Content = "Failed to apply animation: " .. tostring(changed), Icon = "alert-triangle", Duration = 3 })
            end
        end
    })

