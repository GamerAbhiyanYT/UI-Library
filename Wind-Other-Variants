    function aimFindNearest()
        aimCam = workspace.CurrentCamera
        aimMyChar = LocalPlayer.Character
        aimMyRoot = aimMyChar and aimMyChar:FindFirstChild("HumanoidRootPart")
        aimBest = nil
        aimBestScore = math.huge

        for _, p in ipairs(PlayersService:GetPlayers()) do
            if p ~= LocalPlayer then
                aimPart = aimGetPart(p)
                if aimPart then
                    aimScore = nil

                    if aimNearestType == "From Camera" then
                        if aimCam then
                            aimDir = aimPart.Position - aimCam.CFrame.Position
                            if aimDir.Magnitude > 0 then
                                aimDot = aimCam.CFrame.LookVector:Dot(aimDir.Unit)
                                if aimDot > 0 then
                                    aimScore = math.acos(math.clamp(aimDot, -1, 1))
                                end
                            end
                        end
                    else
                        if aimMyRoot then
                            aimScore = (aimPart.Position - aimMyRoot.Position).Magnitude
                        end
                    end

                    if aimScore and aimScore < aimBestScore then
                        aimBestScore = aimScore
                        aimBest = p
                    end
                end
            end
        end

        return aimBest
    end

