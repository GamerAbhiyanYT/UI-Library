    function followStop()
        followEnabled = false
        followLastPos = nil

        if followConn then
            followConn:Disconnect()
            followConn = nil
        end

        fChar = LocalPlayer.Character
        fHum = fChar and fChar:FindFirstChildOfClass("Humanoid")
        fRoot = fChar and fChar:FindFirstChild("HumanoidRootPart")
        if fHum and fRoot then
            fHum:MoveTo(fRoot.Position)
        end
    end

    function followStep()
        fNow = os.clock()
        if fNow - followLastMove < FOLLOW_INTERVAL then return end
        followLastMove = fNow

        if not followTarget or followTarget.Parent ~= PlayersService then return end

        fMyChar = LocalPlayer.Character
        fMyHum = fMyChar and fMyChar:FindFirstChildOfClass("Humanoid")
        fMyRoot = fMyChar and fMyChar:FindFirstChild("HumanoidRootPart")
        fTargetChar = followTarget.Character
        fTargetRoot = fTargetChar and fTargetChar:FindFirstChild("HumanoidRootPart")

        if not (fMyHum and fMyRoot and fTargetRoot) then return end
        if fMyHum.Health <= 0 then return end

        fDistance = (fTargetRoot.Position - fMyRoot.Position).Magnitude

        if fDistance > FOLLOW_DISTANCE then
            fMyHum:MoveTo(fTargetRoot.Position)

            if fNow - followLastCheck >= 0.6 then
                followLastCheck = fNow
                if followLastPos and (fMyRoot.Position - followLastPos).Magnitude < 0.5 and fDistance > FOLLOW_DISTANCE + 2 then
                    fMyHum.Jump = true
                end
                followLastPos = fMyRoot.Position
            end
        else
            fMyHum:MoveTo(fMyRoot.Position)
            followLastPos = nil
        end
    end

    function followStart()
        if followConn then
            followConn:Disconnect()
