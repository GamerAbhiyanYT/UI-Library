    end

    function HB_Destroy(o)
        if o.out then o.out:Remove() end
        if o.fill then o.fill:Remove() end
        if o.label then AxparnESP.LabelRemove(o.label) end
    end

    function HB_Render(o, ctx)
        HB_Target = math.clamp(ctx.hum.Health / math.max(ctx.hum.MaxHealth, 1), 0, 1)
        if HB_Config.SmoothAnimation and o.ratio then
            o.ratio = o.ratio + (HB_Target - o.ratio) * (1 - math.exp(-HB_Config.SmoothSpeed * ctx.dt))
        else
            o.ratio = HB_Target
        end
        HB_Ratio = o.ratio

        if HB_Config.Side == "Top" then
            HB_BarW = math.max(ctx.bounds.halfW * 2 - HB_Config.BarVerticalTrim * 2, 4)
            HB_BarH = HB_Config.BarThickness
            HB_BarX = math.floor(ctx.bounds.x - HB_BarW / 2 + HB_Config.WidthOffset + 0.5)
            HB_BarY = math.floor(ctx.bounds.top - HB_Config.BarSideGap - HB_BarH + 0.5)
            HB_FillX, HB_FillY, HB_FillW, HB_FillH = HB_BarX, HB_BarY, HB_BarW * HB_Ratio, HB_BarH
        else
            HB_BarW = HB_Config.BarThickness
            HB_BarH = math.max(ctx.bounds.bottom - ctx.bounds.top - HB_Config.BarVerticalTrim * 2, 2)
            HB_BarY = math.floor(ctx.bounds.top + HB_Config.BarVerticalTrim + 0.5)
            if HB_Config.Side == "Left" then
                HB_BarX = math.floor(ctx.bounds.x - ctx.bounds.halfW - HB_Config.BarSideGap - HB_BarW + HB_Config.WidthOffset + 0.5)
            else
                HB_BarX = math.floor(ctx.bounds.x + ctx.bounds.halfW + HB_Config.BarSideGap + HB_Config.WidthOffset + 0.5)
            end
            HB_FillH = HB_BarH * HB_Ratio
            HB_FillX, HB_FillY, HB_FillW = HB_BarX, HB_BarY + HB_BarH - HB_FillH, HB_BarW
        end

        if HB_Config.Enabled then
            if not o.out then
                o.out = Drawing.new("Square")
                o.out.Filled = true
                o.out.ZIndex = 1
                o.oc = { Visible = false }
                o.fill = Drawing.new("Square")
                o.fill.Filled = true
                o.fill.ZIndex = 2
                o.fc = { Visible = false }
            end

            if HB_Config.OutlineEnabled then
                HB_Set(o.out, o.oc, "Position", Vector2.new(HB_BarX - HB_Config.OutlinePadX, HB_BarY - HB_Config.OutlinePadY))
                HB_Set(o.out, o.oc, "Size", Vector2.new(HB_BarW + HB_Config.OutlinePadX * 2, HB_BarH + HB_Config.OutlinePadY * 2))
                HB_Set(o.out, o.oc, "Color", HB_Config.OutlineColor)
                HB_Set(o.out, o.oc, "Transparency", AxparnESP.Alpha(HB_Config.OutlineTransparency))
                HB_Set(o.out, o.oc, "Visible", true)
            else
                HB_Set(o.out, o.oc, "Visible", false)
            end

            if HB_Config.BarRGB then
                HB_Color = AxparnESP.Rainbow()
            elseif HB_Config.AutoColorBar then
                HB_Color = AxparnESP.HealthColor(HB_Ratio)
            else
                HB_Color = HB_Config.BarColor
            end

            HB_Set(o.fill, o.fc, "Position", Vector2.new(HB_FillX, HB_FillY))
            HB_Set(o.fill, o.fc, "Size", Vector2.new(HB_FillW, HB_FillH))
            HB_Set(o.fill, o.fc, "Color", HB_Color)
            HB_Set(o.fill, o.fc, "Transparency", AxparnESP.Alpha(HB_Config.BarTransparency))
            HB_Set(o.fill, o.fc, "Visible", (HB_Config.Side == "Top" and HB_FillW or HB_FillH) > 0.5)
        elseif o.out then
            HB_Set(o.out, o.oc, "Visible", false)
            HB_Set(o.fill, o.fc, "Visible", false)
        end

        if HB_Config.ShowIndicator then
            if not o.label then
                o.label = AxparnESP.NewLabel()
            end

            if HB_Config.IndicatorFormat == "Percent" then
                HB_Text = math.floor(HB_Target * 100 + 0.5) .. "%"
            elseif HB_Config.IndicatorFormat == "Current / Max" then
                HB_Text = math.ceil(ctx.hum.Health) .. " / " .. math.ceil(ctx.hum.MaxHealth)
            else
                HB_Text = tostring(math.ceil(ctx.hum.Health))
            end

            if HB_Config.Side == "Top" then
                HB_IndY = HB_BarY - HB_Config.OutlinePadY - HB_Config.IndicatorSize - 2
                HB_IndX = HB_Config.IndicatorFollowBar and math.clamp(HB_FillX + HB_FillW, HB_BarX, HB_BarX + HB_BarW) or (HB_BarX + HB_BarW / 2)
                HB_Anchor = "center"
            else
                if HB_Config.IndicatorFollowBar then
                    HB_IndY = math.clamp(HB_FillY - HB_Config.IndicatorSize / 2, HB_BarY - HB_Config.IndicatorSize / 2, HB_BarY + HB_BarH - HB_Config.IndicatorSize / 2)
                else
                    HB_IndY = HB_BarY - HB_Config.IndicatorSize - HB_Config.OutlinePadY - 2
                end
                if HB_Config.Side == "Left" then
                    HB_IndX, HB_Anchor = HB_BarX - HB_Config.OutlinePadX - 3, "right"
                else
                    HB_IndX, HB_Anchor = HB_BarX + HB_BarW + HB_Config.OutlinePadX + 3, "left"
                end
            end

            if HB_Config.BarRGB then
                HB_Color = AxparnESP.Rainbow()
            elseif HB_Config.AutoColorIndicator then
                HB_Color = AxparnESP.HealthColor(HB_Ratio)
            else
                HB_Color = HB_Config.IndicatorColor
            end

            AxparnESP.LabelRender(o.label, HB_Text, HB_IndX, HB_IndY, HB_Config.IndicatorSize, HB_Color,
                AxparnESP.Alpha(HB_Config.IndicatorTransparency), HB_Config.IndicatorOutline,
                Color3.new(0, 0, 0), "Plex", HB_Anchor)
        elseif o.label then
            AxparnESP.LabelHide(o.label)
        end
    end

    HB_Tracker = AxparnESP.NewTracker(HB_Config, {
        render = HB_Render,
        hide = HB_Hide,
        destroy = HB_Destroy,
    })

    function HB_Sync()
        if HB_Config.Enabled or HB_Config.ShowIndicator then
            HB_Tracker:Start()
        else
            HB_Tracker:Stop()
        end

        AxparnESP.Reserve.health = 0
        if (HB_Config.Enabled or HB_Config.ShowIndicator) and HB_Config.Side == "Top" then
            AxparnESP.Reserve.health = HB_Config.BarSideGap + HB_Config.BarThickness + 2
                + (HB_Config.OutlineEnabled and HB_Config.OutlinePadY * 2 or 0)
                + (HB_Config.ShowIndicator and HB_Config.IndicatorSize + 2 or 0)
        end
    end

    function HB_OnChange(key, value)
        if key == "BarRGB" and value then
            HB_Config.AutoColorBar = false
            HB_Config.AutoColorIndicator = false
            pcall(function() HB_UI.AutoColorBar:SetValue(false) end)
            pcall(function() HB_UI.AutoColorIndicator:SetValue(false) end)
        elseif (key == "AutoColorBar" or key == "AutoColorIndicator") and value and HB_Config.BarRGB then
            HB_Config.BarRGB = false
            pcall(function() HB_UI.BarRGB:SetValue(false) end)
        end

        HB_Sync()
    end

    function HB_Reload()
