function Elements.Toggle(parent, cfg)
    cfg = cfg or {}
    local isCheckbox = cfg.Type == "Checkbox"
    local state = cfg.Value == true
    local base = CreateElementCard(parent, {
        Type = "Toggle",
        Title = cfg.Title or "Toggle",
        Desc = cfg.Desc,
        Icon = cfg.Icon,
        RightOffset = 54,
        Clickable = true,
    })

    local switchTrack, switchKnob
    if isCheckbox then
        switchTrack = Creator.NewRoundFrame(8, "Squircle", {
            Size = UDim2.new(0, 24, 0, 24),
            Position = UDim2.new(1, 0, 0.5, 0),
            AnchorPoint = Vector2.new(1, 0.5),
            ImageTransparency = state and 0 or 0.85,
            ThemeTag = { ImageColor3 = state and "Checkbox" or "Text" },
            Parent = base.Inner,
        })
        switchKnob = Creator.New("TextLabel", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "✓",
            TextSize = 15,
            FontFace = Font.new(Creator.Font, Enum.FontWeight.Bold),
            TextTransparency = state and 0 or 1,
            ThemeTag = { TextColor3 = "CheckboxIcon" },
            Parent = switchTrack,
        })
    else
        switchTrack = Creator.NewRoundFrame(99, "Squircle", {
            Size = UDim2.new(0, 44, 0, 24),
            Position = UDim2.new(1, 0, 0.5, 0),
            AnchorPoint = Vector2.new(1, 0.5),
            ImageTransparency = state and 0 or 0.85,
            ThemeTag = { ImageColor3 = state and "Toggle" or "Text" },
            Parent = base.Inner,
        })
        switchKnob = Creator.NewRoundFrame(99, "Squircle", {
            Size = UDim2.new(0, 18, 0, 18),
            Position = state and UDim2.new(1, -3, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
            AnchorPoint = state and Vector2.new(1, 0.5) or Vector2.new(0, 0.5),
            ThemeTag = { ImageColor3 = "ToggleBar" },
            Parent = switchTrack,
        })
    end

    local api = { __type = "Toggle", Value = state, Instance = base.Card }

    function api:Set(newVal, silent)
        state = newVal == true
        api.Value = state
        if isCheckbox then
            Creator.SetThemeTag(switchTrack, { ImageColor3 = state and "Checkbox" or "Text" }, 0.14)
            Creator.Tween(switchTrack, 0.14, { ImageTransparency = state and 0 or 0.85 }):Play()
            Creator.Tween(switchKnob, 0.14, { TextTransparency = state and 0 or 1 }):Play()
        else
            Creator.SetThemeTag(switchTrack, { ImageColor3 = state and "Toggle" or "Text" }, 0.16)
            Creator.Tween(switchTrack, 0.16, { ImageTransparency = state and 0 or 0.85 }):Play()
            Creator.Tween(switchKnob, 0.22, {
                Position = state and UDim2.new(1, -3, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
                AnchorPoint = state and Vector2.new(1, 0.5) or Vector2.new(0, 0.5),
