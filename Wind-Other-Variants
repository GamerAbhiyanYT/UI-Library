    function getRegionTimestamp(region)
        months = {"January","February","March","April","May","June","July","August","September","October","November","December"}
        now = os.date("!*t")
        success, offsets = pcall(function()
            return loadstring(game:HttpGet("https://pastebin.com/raw/Wd25g5dv"))()
        end)
        offset = (success and offsets and offsets[region]) or 0
        t = os.time(now) + offset * 3600
        dt = os.date("!*t", t)
    
        hour, suffix = dt.hour, "AM"
        if hour >= 12 then
            suffix = "PM"
            if hour > 12 then hour = hour - 12 end
        elseif hour == 0 then
            hour = 12
        end
    
        sign = offset >= 0 and "+" or ""
        return string.format("%s %d, %d at %d:%02d %s UTC%s",
            months[dt.month], dt.day, dt.year, hour, dt.min, suffix, sign..offset
        )
    end
    
