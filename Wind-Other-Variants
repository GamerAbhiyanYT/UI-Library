        OutlinePadY = 1,        -- outline thickness: top / bottom of the bar

        BarSideGap = 4,         -- distance between the player and the bar
        BarVerticalTrim = 0,    -- shortens the bar from both ends

        BarTransparency = 0,
        IndicatorTransparency = 0,

