        Parent = base.Inner,
    })

    local drawer = Creator.New("Frame", {
        Size = UDim2.new(1, 0, 0, 68),
        BackgroundTransparency = 1,
        Visible = false,
        LayoutOrder = 20,
        Parent = base.TextHolder,
    }, {
        Creator.New("UIPadding", { PaddingTop = UDim.new(0, 8) }),
        Creator.New("UIListLayout", { FillDirection = Enum.FillDirection.Vertical, Padding = UDim.new(0, 6) }),
    })

    local function MakeBar(labelText, getGrad, onSlide)
        local row = Creator.New("Frame", {
            Size = UDim2.new(1, 0, 0, 16),
            BackgroundTransparency = 1,
            Parent = drawer,
        })
        Creator.New("TextLabel", {
            Size = UDim2.new(0, 28, 1, 0),
            BackgroundTransparency = 1,
            Text = labelText,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            ThemeTag = { TextColor3 = "PlaceholderText" },
            Parent = row,
        })
        local bar = Creator.New("TextButton", {
            Size = UDim2.new(1, -34, 0, 12),
            Position = UDim2.new(0, 34, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            Text = "",
            Parent = row,
        }, {
            Creator.New("UICorner", { CornerRadius = UDim.new(1, 0) }),
            getGrad(),
        })
        local drag = false
        local function Update(x)
            local r = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
            onSlide(r)
        end
        bar.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                drag = true
                Update(inp.Position.X)
            end
        end)
        Creator.AddSignal(UserInputService.InputChanged, function(inp)
            if drag and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                Update(inp.Position.X)
            end
        end)
        Creator.AddSignal(UserInputService.InputEnded, function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                drag = false
            end
        end)
    end

    local api = { __type = "Colorpicker", Default = currentColor, Instance = base.Card }
    local function ApplyHSV()
        currentColor = Color3.fromHSV(h, s, v)
        api.Default = currentColor
        swatch.ImageColor3 = currentColor
        Creator.SafeCallback(cfg.Callback, currentColor)
    end

    MakeBar("HUE", function()
        local kps = {}
        for i = 0, 6 do
            table.insert(kps, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 1, 1)))
        end
        return Creator.New("UIGradient", { Color = ColorSequence.new(kps) })
    end, function(r) h = r; ApplyHSV() end)

    MakeBar("SAT", function()
        return Creator.New("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromHex("#0091FF")) })
    end, function(r) s = r; ApplyHSV() end)

    MakeBar("VAL", function()
        return Creator.New("UIGradient", { Color = ColorSequence.new(Color3.new(0, 0, 0), Color3.new(1, 1, 1)) })
    end, function(r) v = r; ApplyHSV() end)

    function api:Update(c)
        currentColor = c
        api.Default = c
        h, s, v = Color3.toHSV(c)
        swatch.ImageColor3 = c
    end
    api.Set = api.Update

    base.Card.MouseButton1Click:Connect(function()
        opened = not opened
        drawer.Visible = opened
    end)

    ConfigManager:Register(cfg.Flag, api)
    return api
end

