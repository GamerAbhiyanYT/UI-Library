function Elements.Label(parent, cfg)
    cfg = cfg or {}
    local row = Creator.New("Frame", {
        Name = "LabelElement",
        Size = UDim2.new(1, 0, 0, 22),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Parent = parent,
    }, {
        Creator.New("UIPadding", {
            PaddingLeft = UDim.new(0, 4),
            PaddingRight = UDim.new(0, 4),
            PaddingTop = UDim.new(0, 2),
            PaddingBottom = UDim.new(0, 2),
        }),
    })

    local leftLbl = Creator.New("TextLabel", {
        Name = "LeftText",
        Size = UDim2.new(0.6, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Text = cfg.Left or cfg.Title or "text 1",
        TextColor3 = cfg.LeftColor,
        ThemeTag = not cfg.LeftColor and { TextColor3 = "Text" } or nil,
        TextSize = cfg.TextSize or 15,
        FontFace = Font.new(Creator.Font, Enum.FontWeight.SemiBold),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Parent = row,
    })

    local rightLbl = Creator.New("TextLabel", {
        Name = "RightText",
        Size = UDim2.new(0.4, 0, 0, 0),
        Position = UDim2.new(1, 0, 0, 0),
        AnchorPoint = Vector2.new(1, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Text = cfg.Right or cfg.Value or "text 2",
        TextColor3 = cfg.RightColor,
        TextTransparency = cfg.RightColor and 0 or 0.35,
        ThemeTag = not cfg.RightColor and { TextColor3 = "Text" } or nil,
        TextSize = cfg.TextSize or 15,
        FontFace = Font.new(Creator.Font, Enum.FontWeight.Medium),
        TextXAlignment = Enum.TextXAlignment.Right,
        TextWrapped = true,
        Parent = row,
    })

    local api = { __type = "Label", Instance = row }
    function api:SetLeft(t) leftLbl.Text = tostring(t) end
    function api:SetRight(t) rightLbl.Text = tostring(t) end
    function api:Set(l, r)
        if l ~= nil then leftLbl.Text = tostring(l) end
        if r ~= nil then rightLbl.Text = tostring(r) end
    end
    return api
end

-- [2] PROGRESS BAR (Percent / Without Percent / Custom Text + Thumb O)
function Elements.ProgressBar(parent, cfg)
    cfg = cfg or {}
    local minVal = cfg.Min or 0
    local maxVal = cfg.Max or 100
    local curVal = math.clamp(cfg.Value or 0, minVal, maxVal)
    local mode = cfg.Mode or (cfg.ShowPercent == false and "None" or (cfg.CustomText and "Custom" or "Percent"))
    local customText = cfg.CustomText or ""
    local showValue = mode ~= "None"
    local barWidth = cfg.Width or 155
    local textWidth = showValue and 54 or 0

    local base = CreateElementCard(parent, {
        Type = "ProgressBar",
        Title = cfg.Title or "Progress",
        Desc = cfg.Desc,
        Icon = cfg.Icon,
        RightOffset = barWidth + textWidth + 14,
    })

    local rightHolder = Creator.New("Frame", {
        Size = UDim2.new(0, barWidth + textWidth + (showValue and 8 or 0), 0, 24),
        Position = UDim2.new(1, 0, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundTransparency = 1,
        Parent = base.Inner,
    })

    local track = Creator.NewRoundFrame(99, "Squircle", {
        Size = UDim2.new(0, barWidth, 0, 6),
        Position = UDim2.new(0, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        ThemeTag = {
            ImageColor3 = "ProgressBarTrack",
            ImageTransparency = "ProgressBarTrackTransparency",
        },
        Parent = rightHolder,
    })

    local fill = Creator.NewRoundFrame(99, "Squircle", {
        Size = UDim2.new(0, 0, 1, 0),
        ImageColor3 = cfg.Color,
        ThemeTag = not cfg.Color and { ImageColor3 = "ProgressBar" } or nil,
        Parent = track,
    }, {
        Creator.NewRoundFrame(99, "Squircle", {
            Size = UDim2.new(0, 12, 0, 12),
            Position = UDim2.new(1, 0, 0.5, 0),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Visible = cfg.ShowThumb ~= false,
            ThemeTag = { ImageColor3 = "SliderThumb" },
        }),
    })

    local valLabel = Creator.New("TextLabel", {
        Size = UDim2.new(0, textWidth, 0, 20),
        Position = UDim2.new(1, 0, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundTransparency = 1,
        TextSize = 14,
        TextTransparency = 0.25,
        FontFace = Font.new(Creator.Font, Enum.FontWeight.Medium),
        TextXAlignment = Enum.TextXAlignment.Right,
        Visible = showValue,
        ThemeTag = { TextColor3 = "ProgressBarText" },
        Parent = rightHolder,
    })

    local function Render(v, overrideCustom)
        curVal = math.clamp(v, minVal, maxVal)
        local ratio = (maxVal > minVal) and ((curVal - minVal) / (maxVal - minVal)) or 0
        Creator.Tween(fill, 0.16, { Size = UDim2.new(ratio, 0, 1, 0) }):Play()
        if mode == "Percent" then
            valLabel.Text = tostring(math.floor(ratio * 100 + 0.5)) .. "%"
        elseif mode == "Custom" then
            if overrideCustom ~= nil then
                customText = tostring(overrideCustom)
            end
            valLabel.Text = customText ~= "" and customText or (tostring(curVal) .. (cfg.Suffix or ""))
        end
    end

    Render(curVal, customText)

    local api = { __type = "ProgressBar", Instance = base.Card }
    function api:Set(val, newCustom) Render(val, newCustom) end
    function api:Get() return curVal end
    function api:SetTitle(t) base.TitleLabel.Text = tostring(t) end
    return api
end

-- [3] MULTITOGGLE / RADIO
function Elements.MultiToggle(parent, cfg)
    cfg = cfg or {}
    local isMulti = cfg.Multi == true
    local options = cfg.Options or { "feature 1", "feature 2", "feature 3" }
    local selected = {}

    if isMulti then
        if type(cfg.Default) == "table" then
            for _, v in ipairs(cfg.Default) do selected[v] = true end
        end
    else
        local def = cfg.Default or options[1]
        if def then selected[def] = true end
    end

    local card = Creator.NewRoundFrame(12, "Squircle", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ThemeTag = {
            ImageColor3 = "ElementBackground",
            ImageTransparency = "ElementBackgroundTransparency",
        },
        Parent = parent,
    }, {
        Creator.New("UIPadding", {
            PaddingTop = UDim.new(0, 12),
            PaddingBottom = UDim.new(0, 12),
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12),
        }),
        Creator.New("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical,
            Padding = UDim.new(0, 8),
        }),
    })

    Creator.New("TextLabel", {
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundTransparency = 1,
        Text = cfg.Title or "Select Option",
        TextSize = 15,
        FontFace = Font.new(Creator.Font, Enum.FontWeight.SemiBold),
        TextXAlignment = Enum.TextXAlignment.Left,
        ThemeTag = { TextColor3 = "ElementTitle" },
        LayoutOrder = 0,
        Parent = card,
    })

    local itemRefs = {}

    local function Emit()
        if not cfg.Callback then return end
        if isMulti then
            local list = {}
            for _, opt in ipairs(options) do
                if selected[opt] then table.insert(list, opt) end
            end
            Creator.SafeCallback(cfg.Callback, list, selected)
        else
            for _, opt in ipairs(options) do
                if selected[opt] then
                    Creator.SafeCallback(cfg.Callback, opt)
                    break
                end
            end
        end
    end

    local function UpdateVisuals()
        for opt, ref in pairs(itemRefs) do
            local active = selected[opt] == true
            Creator.Tween(ref.Dot, 0.14, {
                Size = active and UDim2.new(0, 10, 0, 10) or UDim2.new(0, 0, 0, 0),
                BackgroundTransparency = active and 0 or 1,
            }):Play()
            Creator.Tween(ref.Label, 0.14, { TextTransparency = active and 0 or 0.4 }):Play()
        end
    end

    local function Build(opts)
        for _, ref in pairs(itemRefs) do ref.Row:Destroy() end
        table.clear(itemRefs)
        options = opts

        for idx, opt in ipairs(options) do
            local row = Creator.New("TextButton", {
                Size = UDim2.new(1, 0, 0, 22),
                BackgroundTransparency = 1,
                Text = "",
                LayoutOrder = idx,
                Parent = card,
            })

            local ring = Creator.New("Frame", {
                Size = UDim2.new(0, 18, 0, 18),
                Position = UDim2.new(0, 2, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                BackgroundTransparency = 1,
                Parent = row,
            }, {
                Creator.New("UICorner", { CornerRadius = UDim.new(isMulti and 0 or 1, isMulti and 5 or 0) }),
                Creator.New("UIStroke", {
                    Thickness = 1.6,
                    Transparency = 0.35,
                    ThemeTag = { Color = "Primary" },
                }),
            })

            local dot = Creator.New("Frame", {
                Size = UDim2.new(0, 0, 0, 0),
                Position = UDim2.new(0.5, 0, 0.5, 0),
                AnchorPoint = Vector2.new(0.5, 0.5),
                BackgroundTransparency = 1,
                ThemeTag = { BackgroundColor3 = "Primary" },
                Parent = ring,
            }, {
                Creator.New("UICorner", { CornerRadius = UDim.new(isMulti and 0 or 1, isMulti and 3 or 0) }),
            })

            local lbl = Creator.New("TextLabel", {
                Size = UDim2.new(1, -28, 1, 0),
                Position = UDim2.new(0, 28, 0, 0),
                BackgroundTransparency = 1,
                Text = tostring(opt),
                TextSize = 14,
                TextTransparency = 0.4,
                FontFace = Font.new(Creator.Font, Enum.FontWeight.Medium),
                TextXAlignment = Enum.TextXAlignment.Left,
                ThemeTag = { TextColor3 = "Text" },
                Parent = row,
            })

            itemRefs[opt] = { Row = row, Dot = dot, Label = lbl }

            row.MouseButton1Click:Connect(function()
                if isMulti then
                    selected[opt] = not selected[opt]
                else
                    if selected[opt] then return end
                    table.clear(selected)
                    selected[opt] = true
                end
                UpdateVisuals()
                Emit()
            end)
        end
        UpdateVisuals()
    end

    Build(options)

    local api = { __type = "MultiToggle", Instance = card }
    function api:Set(val)
        table.clear(selected)
        if isMulti and type(val) == "table" then
            for _, v in ipairs(val) do selected[v] = true end
        elseif val ~= nil then
            selected[val] = true
        end
        UpdateVisuals()
        Emit()
    end
    function api:Get()
        if isMulti then
            local out = {}
            for _, opt in ipairs(options) do
                if selected[opt] then table.insert(out, opt) end
            end
            return out
        end
        for _, opt in ipairs(options) do
            if selected[opt] then return opt end
        end
        return nil
    end
    function api:Refresh(newOpts) Build(newOpts) end

    ConfigManager:Register(cfg.Flag, api)
    return api
end

