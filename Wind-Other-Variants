                if not AR.Enabled or AR.Busy then return end
                AR.Busy = true
                AR.Attempt = 1
                pcall(function()
                    WindUI:Notify({ Title = "Auto Rejoin", Content = "Connection lost, rejoining the game...", Icon = "refresh-cw", Duration = 3 })
