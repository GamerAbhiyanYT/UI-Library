    end

    AN = {
        Ids = { idle = "", walk = "", run = "", jump = "", fall = "" },
        UI = {},
        Conn = nil,
        Run = nil,
        Orig = setmetatable({}, { __mode = "k" }), -- [Character] = { [Animation] = original AnimationId }
        Map = {
            idle = { "idle", { "Animation1", "Animation2" } },
            walk = { "walk", { "WalkAnim" } },
            run  = { "run",  { "RunAnim" } },
            jump = { "jump", { "JumpAnim" } },
            fall = { "fall", { "FallAnim" } },
        },
    }

    -- accepts "123456", "rbxassetid://123456" or a catalog link; empty = keep default
    function AN.Set(key, input)
        input = tostring(input or "")
        AN.Ids[key] = input:match("%d+") or ""
        if input ~= "" and AN.Ids[key] == "" then
            WindUI:Notify({ Title = "Invalid ID", Content = "Enter numbers only, e.g. 507766388", Icon = "alert-triangle", Duration = 2 })
        end
    end

    -- reload the Animate script so new/old IDs take effect immediately
    function AN.Refresh(char, animate, hum, animator)
        animate = char and char:FindFirstChild("Animate")
        hum = char and char:FindFirstChildOfClass("Humanoid")
        if not animate then return end

        animate.Enabled = false
        animator = hum and hum:FindFirstChildOfClass("Animator")
        if animator then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                track:Stop(0)
            end
        end
        task.wait()
        animate.Enabled = true
    end

