do
    SecVisual = TabHandles.Visual:Section({ 
        Title = "Transparant Vision",
        Box = true,
        TextXAlignment = "Left",
        TextSize = 17,
        Opened = true,
    })

    xRayConnection = nil

    SecVisual:Toggle({
        Title = "X-ray Vision",
        Desc = "Make all parts transparent ( Causes Lag For Some Devices )",
        Value = false,
        Callback = function(state) 
            character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

            function setPartXRay(part, enabled)
                if part:IsA("BasePart") and part.Transparency < 1 then
                    if not part:IsDescendantOf(LocalPlayer.Character or character) then
                        part.LocalTransparencyModifier = enabled and 0.7 or 0
                    end
                end
            end

            -- [FIX FREEZE] Dulu: satu loop sinkron di SELURUH workspace -> game freeze beberapa detik di map besar.
            -- Sekarang: dikerjakan bertahap (500 part per frame) dan bisa dibatalkan kalau toggle diganti cepat.
            xRayJob = (xRayJob or 0) + 1
            local myJob = xRayJob

            function setXRay(enabled)
                task.spawn(function()
                    local all = workspace:GetDescendants()
                    for i = 1, #all do
                        if myJob ~= xRayJob then return end
                        pcall(setPartXRay, all[i], enabled)
                        if i % 500 == 0 then task.wait() end
                    end
                end)
            end

            if xRayConnection then
                xRayConnection:Disconnect()
                xRayConnection = nil
            end

            setXRay(state)

            if state then
                xRayConnection = workspace.DescendantAdded:Connect(function(part)
                    pcall(setPartXRay, part, true)
                end)
            end
        end
    })
end

