                    if not FC.Enabled then return end
                    FC.Cam = workspace.CurrentCamera
                    FC.Cam.CameraType = Enum.CameraType.Scriptable
                    FC.Freeze()
    
                    -- rotasi
                    FC.Look = FC.RightHeld and FC.UIS:GetMouseDelta() or Vector2.zero
                    FC.Look = FC.Look + FC.TouchDelta
                    FC.TouchDelta = Vector2.zero
                    FC.Yaw = FC.Yaw - math.rad(FC.Look.X * 0.25)
                    FC.Pitch = math.clamp(FC.Pitch - math.rad(FC.Look.Y * 0.25), math.rad(-89), math.rad(89))
                    FC.Rot = CFrame.fromOrientation(FC.Pitch, FC.Yaw, 0)
    
                    -- gerak
                    FC.Move = Vector3.zero
                    if not FC.UIS:GetFocusedTextBox() then
                        if FC.UIS:IsKeyDown(Enum.KeyCode.W) then FC.Move = FC.Move + Vector3.new(0, 0, -1) end
                        if FC.UIS:IsKeyDown(Enum.KeyCode.S) then FC.Move = FC.Move + Vector3.new(0, 0, 1) end
                        if FC.UIS:IsKeyDown(Enum.KeyCode.A) then FC.Move = FC.Move + Vector3.new(-1, 0, 0) end
                        if FC.UIS:IsKeyDown(Enum.KeyCode.D) then FC.Move = FC.Move + Vector3.new(1, 0, 0) end
                        if FC.UIS:IsKeyDown(Enum.KeyCode.E) then FC.Move = FC.Move + Vector3.new(0, 1, 0) end
                        if FC.UIS:IsKeyDown(Enum.KeyCode.Q) then FC.Move = FC.Move + Vector3.new(0, -1, 0) end
                    end
                    FC.WorldMove = FC.Rot:VectorToWorldSpace(FC.Move)
    
                    -- joystick HP
                    FC.Hum = FC.GetHum()
                    if FC.Hum and FC.Hum.MoveDirection.Magnitude > 0 and FC.Move.Magnitude == 0 then
                        FC.WorldMove = FC.Hum.MoveDirection
                    end
    
                    FC.Spd = FC.Speed
                    if FC.UIS:IsKeyDown(Enum.KeyCode.LeftShift) then FC.Spd = FC.Spd * 3 end
                    if FC.UIS:IsKeyDown(Enum.KeyCode.LeftControl) then FC.Spd = FC.Spd * 0.3 end
    
                    FC.Target = FC.WorldMove.Magnitude > 0 and FC.WorldMove.Unit * FC.Spd or Vector3.zero
                    FC.Vel = FC.Vel:Lerp(FC.Target, math.clamp(dt * 12, 0, 1))
                    FC.Pos = FC.Pos + FC.Vel * dt
    
                    FC.Cam.CFrame = CFrame.new(FC.Pos) * FC.Rot
                end
    
                FC.RS:BindToRenderStep("AxparnFreecam", Enum.RenderPriority.Camera.Value + 1, FC.Step)
            else
                if not FC.Enabled then return end
                FC.Enabled = false
    
                pcall(function() FC.RS:UnbindFromRenderStep("AxparnFreecam") end)
