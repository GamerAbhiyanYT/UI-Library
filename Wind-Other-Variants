    function CS_Sync(key, value, source)
        if not CS_Ctl[key] then return end
        if source ~= "slider" then CS_SetCtl(CS_Ctl[key].slider, value) end
        if source ~= "input" then CS_SetCtl(CS_Ctl[key].input, tostring(value)) end
    end

    function CS_SetValue(key, raw, source)
        CS_Num = tonumber(raw)
        if not CS_Num then
            CS_Notify("Error", "Enter a valid number for " .. CS_Labels[key], "alert-triangle")
            return
        end

        CS_Clamped = math.clamp(CS_Num, CS_Limits[key][1], CS_Limits[key][2])
        if CS_Clamped ~= CS_Num then
            CS_Notify("Adjusted", CS_Labels[key] .. " limited to " .. CS_Limits[key][1] .. " - " .. CS_Limits[key][2], "info")
        end

        CS_State[key] = CS_Clamped
        CS_Active[key] = true
        pcall(CS_Apply, key, CS_Clamped)
        CS_Sync(key, CS_Clamped, source)
    end

    function CS_Reset(key)
        CS_State[key] = CS_Defaults[key]
        CS_Active[key] = false
        pcall(CS_Apply, key, CS_Defaults[key])
        CS_Sync(key, CS_Defaults[key], nil)
        CS_Notify("Reset", CS_Labels[key] .. " back to " .. tostring(CS_Defaults[key]))
    end

    function CS_ApplySaved(resetUnsaved)
        for _, key in ipairs(CS_Keys) do
            if CS_Active[key] then
                if CS_Save[key] then
                    pcall(CS_Apply, key, CS_State[key])
                elseif resetUnsaved then

                    CS_State[key] = CS_Defaults[key]
                    CS_Active[key] = false

                    if key == "FOV" or key == "Gravity" or key == "MaxZoom" then
                        pcall(CS_Apply, key, CS_Defaults[key])
                    end
                    CS_Sync(key, CS_Defaults[key], nil)
                end
            end
        end
    end

