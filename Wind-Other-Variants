        if dat then
            -- [FIX LEAK] Dulu: pairs() memanggil :Remove() pada tabel `Lines` (bukan Drawing) -> gagal diam-diam,
            -- jadi 5-14 Line drawing bocor SETIAP kali pemain mati/respawn -> makin lama makin lag/freeze.
            if dat.Head then pcall(function() dat.Head:Remove() end) end
            for _, ln in pairs(dat.Lines) do
                pcall(function() ln:Remove() end)
            end
            SkeletonDrawings[player] = nil
        end
    end
    
    R6_Bones = {
        {"Head", "Torso"},
        {"Torso", "Left Arm"},
        {"Torso", "Right Arm"},
        {"Torso", "Left Leg"},
        {"Torso", "Right Leg"}
    }
    
    R15_Bones = {
        {"Head", "UpperTorso"},
        {"UpperTorso", "LowerTorso"},
        {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
        {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
        {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
        {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"}
    }
    
    SkeletonWasOn = false
    SkeletonPartCache = setmetatable({}, { __mode = "k" }) -- [FIX LAG] cache part per karakter (tidak FindFirstChild tiap frame)

    function skeletonGetParts(char, bones, now)
        local c = SkeletonPartCache[char]
        if not c or now > c.exp then
            c = c or {}
            c.exp = now + 1
            for _, bone in ipairs(bones) do
                c[bone[1]] = char:FindFirstChild(bone[1])
                c[bone[2]] = char:FindFirstChild(bone[2])
            end
            SkeletonPartCache[char] = c
        end
        return c
    end

    RunService.RenderStepped:Connect(function()
        if not (Drawing and Drawing.new) then return end

        -- [FIX LAG] Saat fitur OFF: sembunyikan sekali lalu keluar (dulu tetap loop semua pemain tiap frame
        -- dan membuat Drawing untuk tiap pemain walau fitur mati)
