    WE_List, WE_Prev, WE_Conns, WE_Black, WE_Resets = {}, {}, {}, {}, {}
    WE_Stamp, WE_ScanId, WE_LoopId = 0, 0, 0
    WE_Running, WE_Resetting, WE_Warned, WE_Notified = false, false, false, false
    WE_CL = ""

    if WE_Container then
        pcall(function() WE_Container:Destroy() end)
    end
    WE_Container = Instance.new("Folder")
    WE_Container.Name = "AxparnWorldESP"
    pcall(function()
        WE_Container.Parent = (gethui and gethui()) or CoreGui
    end)
    if not WE_Container.Parent then
        WE_Container.Parent = workspace
    end

    function WE_ParseBlacklist()
        table.clear(WE_Black)
        for token in string.gmatch(string.lower(WE_Config.NameBlacklist or ""), "[^,]+") do
            token = token:match("^%s*(.-)%s*$")
            if token ~= "" then
                table.insert(WE_Black, token)
            end
        end
    end

    function WE_Blocked(name)
        name = string.lower(name)
        for i = 1, #WE_Black do
            if string.find(name, WE_Black[i], 1, true) then
                return true
            end
        end
        return false
    end

    function WE_Resolve(obj)
        if obj and obj:IsA("Attachment") then
            obj = obj.Parent
        end
        if not obj then return nil end
        if obj:IsA("Model") then
            return (not obj:FindFirstChildOfClass("Humanoid")) and obj or nil
        end
        if obj:IsA("BasePart") then
            WE_RM = obj:FindFirstAncestorOfClass("Model")
            if WE_RM then
                if WE_RM:FindFirstChildOfClass("Humanoid") then return nil end
                if WE_RM:GetExtentsSize().Magnitude <= 40 then return WE_RM end
            end
            return obj
        end
        return nil
    end

    function WE_Add(cat, target, aux)
        if not WE_Targets[cat][target] then
            WE_Targets[cat][target] = { target = target, cat = cat, aux = aux }
        end
    end

    function WE_Classify(inst)
        WE_C = WE_Config

        if WE_C.NPC and inst:IsA("Humanoid") then
            WE_M = inst.Parent
            if WE_M and WE_M:IsA("Model") and not Players:GetPlayerFromCharacter(WE_M) then
                WE_Add("NPC", WE_M, inst)
            end
        end

        if WE_C.Items then
            if inst:IsA("Tool") then
                if inst.Parent and not inst.Parent:FindFirstChildOfClass("Humanoid") then
                    WE_Add("Items", inst)
                end
            elseif inst:IsA("ProximityPrompt") or inst:IsA("ClickDetector") then
                WE_T = WE_Resolve(inst.Parent)
                if WE_T then
                    WE_Add("Items", WE_T)
                end
            end
        end

        if WE_C.Vehicle and (inst:IsA("VehicleSeat")
            or (inst:IsA("Seat") and string.find(string.lower(inst.Name), "drive", 1, true))) then
            WE_M = inst:FindFirstAncestorOfClass("Model")
            if WE_M then
                WE_Add("Vehicle", WE_M, inst)
            end
        end

        if WE_C.Custom and WE_CL ~= "" then
            WE_K = WE_C.CustomMode
            WE_T = nil
            if WE_K == "Model" then
                if inst:IsA("Model") then WE_T = inst end
            elseif WE_K == "BasePart" then
                if inst:IsA("BasePart") then WE_T = inst end
            elseif inst:IsA(WE_K) then
                WE_T = WE_Resolve(inst.Parent)
            end
            if WE_T and string.find(string.lower(WE_T.Name), WE_CL, 1, true) then
                WE_Add("Custom", WE_T)
            end
        end
    end

    function WE_Valid(e)
        WE_T = e.target
        if not WE_T.Parent or not WE_T:IsDescendantOf(Workspace) then
            return false
        end
        WE_M = WE_T:IsA("Model") and WE_T or WE_T:FindFirstAncestorOfClass("Model")
        return not (WE_M and Players:GetPlayerFromCharacter(WE_M))
    end

    function WE_Allowed(e)
        WE_C = WE_Config
        if e.cat == "NPC" and WE_C.HideDeadNPC and (not e.aux.Parent or e.aux.Health <= 0) then
            return false
        end
        if e.cat == "Vehicle" and WE_C.HideOccupiedVehicle and e.aux.Occupant then
            return false
        end
        return not WE_Blocked(e.target.Name)
    end

    function WE_Pos(e)
        WE_T = e.target
        if WE_T:IsA("PVInstance") then
            return WE_T:GetPivot().Position
        end
        if not e.part or not e.part.Parent then
            e.part = WE_T:FindFirstChildWhichIsA("BasePart", true)
        end
        return e.part and e.part.Position
    end

    function WE_Height(e)
        WE_T = e.target
        if WE_T:IsA("Model") then
            WE_CF, WE_Sz = WE_T:GetBoundingBox()
            return WE_CF.Position.Y - WE_T:GetPivot().Position.Y + WE_Sz.Y / 2
        elseif WE_T:IsA("BasePart") then
            return WE_T.Size.Y / 2
        elseif e.part then
            return e.part.Size.Y / 2
        end
        return 1
    end

    function WE_Cmp(a, b)
        return a.d < b.d
    end

    function WE_Release(e)
        if e.hl then
            e.hl:Destroy()
            e.hl = nil
        end
        if e.label then
            AxparnESP.LabelRemove(e.label)
            e.label = nil
        end
    end

    function WE_Restyle()
        WE_C = WE_Config
        for i = 1, #WE_List do
            WE_E = WE_List[i]
            if WE_C.ShowChams and i <= WE_MaxHL then
                if not WE_E.hl then
                    WE_E.hl = Instance.new("Highlight")
                    WE_E.hl.Name = "AxparnWorldCham"
                    WE_E.hl.Adornee = WE_E.target
                    WE_E.hl.Parent = WE_Container
                end
                WE_E.hl.DepthMode = WE_C.DepthMode == "Occluded" and Enum.HighlightDepthMode.Occluded or Enum.HighlightDepthMode.AlwaysOnTop
                WE_E.hl.FillColor = WE_C[WE_E.cat .. "Fill"]
                WE_E.hl.OutlineColor = WE_C[WE_E.cat .. "Outline"]
                WE_E.hl.FillTransparency = WE_C.FillTransparency
                WE_E.hl.OutlineTransparency = WE_C.OutlineTransparency
            elseif WE_E.hl then
                WE_E.hl:Destroy()
                WE_E.hl = nil
            end
        end
    end

    function WE_Rebuild()
        WE_Cam = Workspace.CurrentCamera
        if not WE_Cam then return end

        WE_C = WE_Config
        WE_Root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        WE_Org = WE_Root and WE_Root.Position or WE_Cam.CFrame.Position
        WE_Stamp = WE_Stamp + 1
        table.clear(WE_List)

        for _, cat in ipairs(WE_Cats) do
            if WE_C[cat] then
                for target, e in pairs(WE_Targets[cat]) do
                    if not WE_Valid(e) then
                        WE_Targets[cat][target] = nil
                    elseif WE_Allowed(e) then
                        WE_P = WE_Pos(e)
                        if WE_P then
                            e.d = (WE_P - WE_Org).Magnitude
                            if e.d <= WE_C.MaxDistance then
                                WE_List[#WE_List + 1] = e
                            end
                        end
                    end
                end
            end
        end

        table.sort(WE_List, WE_Cmp)
        for i = #WE_List, WE_C.Limit + 1, -1 do
            WE_List[i] = nil
        end

        for i = 1, #WE_List do
            WE_List[i].stamp = WE_Stamp
            WE_List[i].h = WE_Height(WE_List[i])
        end

        for i = 1, #WE_Prev do
            if WE_Prev[i].stamp ~= WE_Stamp then
                WE_Release(WE_Prev[i])
            end
        end
        table.clear(WE_Prev)
        for i = 1, #WE_List do
            WE_Prev[i] = WE_List[i]
        end

        WE_Restyle()
    end

    function WE_Step()
        WE_Cam = Workspace.CurrentCamera
        if not WE_Cam or not AxparnESP.Supported then return end

        WE_C = WE_Config
        WE_Show = WE_C.ShowName or WE_C.ShowDistance
        WE_Root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        WE_Org = WE_Root and WE_Root.Position or WE_Cam.CFrame.Position
        WE_Alpha = AxparnESP.Alpha(WE_C.Transparency)
        WE_Rb = WE_C.RGB and AxparnESP.Rainbow() or nil

        for i = 1, #WE_List do
            WE_E = WE_List[i]
            WE_On = false

            if WE_Show and WE_E.target.Parent then
                WE_P = WE_Pos(WE_E)
                if WE_P then
                    WE_V = WE_Cam:WorldToViewportPoint(Vector3.new(WE_P.X, WE_P.Y + (WE_E.h or 1), WE_P.Z))
                    if WE_V.Z > 0 then
                        WE_On = true
                        if not WE_E.label then
                            WE_E.label = AxparnESP.NewLabel()
                        end

                        WE_Tx = WE_C.ShowName and WE_E.target.Name or ""
                        if WE_C.ShowDistance then
                            WE_D = (WE_P - WE_Org).Magnitude
                            if WE_C.DistanceUnit == "Meters" then
                                WE_Dt = "[" .. math.floor(WE_D * 0.28 + 0.5) .. " m]"
                            else
                                WE_Dt = "[" .. math.floor(WE_D + 0.5) .. " studs]"
                            end
                            WE_Tx = WE_Tx == "" and WE_Dt or (WE_Tx .. " " .. WE_Dt)
                        end

                        WE_Col = WE_Rb or (WE_C.UseCategoryColor and WE_C[WE_E.cat .. "Fill"]) or WE_C.TextColor

                        AxparnESP.LabelRender(WE_E.label, WE_Tx, WE_V.X, WE_V.Y - WE_C.Size - WE_C.VerticalOffset,
                            WE_C.Size, WE_Col, WE_Alpha, WE_C.Outline, WE_C.OutlineColor, WE_C.Font, "center")
                    end
                end
            end

            if not WE_On and WE_E.label then
                AxparnESP.LabelHide(WE_E.label)
            end
        end
    end

    function WE_Rescan()
        WE_ScanId = WE_ScanId + 1
        for _, cat in ipairs(WE_Cats) do
            table.clear(WE_Targets[cat])
        end

        task.spawn(function(id)
            for i, inst in ipairs(Workspace:GetDescendants()) do
                pcall(WE_Classify, inst)
                if i % 400 == 0 then
                    task.wait()
                    if id ~= WE_ScanId then return end
                end
            end
            if id == WE_ScanId and WE_Running then
                pcall(WE_Rebuild)
            end
        end, WE_ScanId)
    end

    function WE_Start()
        if WE_Running then return end
        WE_Running = true
        WE_LoopId = WE_LoopId + 1

        WE_Conns[1] = Workspace.DescendantAdded:Connect(function(inst)
            pcall(WE_Classify, inst)
        end)
        WE_Conns[2] = Workspace.DescendantRemoving:Connect(function(inst)
            for _, cat in ipairs(WE_Cats) do
                WE_Targets[cat][inst] = nil
            end
        end)
        WE_Conns[3] = RunService.RenderStepped:Connect(WE_Step)

        if not AxparnESP.Supported and not WE_Notified then
            WE_Notified = true
            AxparnESP.Notify("Limited", "No Drawing library: only chams are shown, text is skipped", "triangle-alert")
        end

        WE_Rescan()

        task.spawn(function(id)
            while WE_Running and id == WE_LoopId do
                task.wait(WE_Config.ScanInterval)
                if WE_Running and id == WE_LoopId then
                    WE_Ok, WE_Err = pcall(WE_Rebuild)
                    if not WE_Ok and not WE_Warned then
                        WE_Warned = true
                        warn("[Axparn World ESP] rebuild error:", WE_Err)
                    end
                end
            end
        end, WE_LoopId)
    end

    function WE_Stop()
        WE_Running = false
        WE_LoopId = WE_LoopId + 1
        WE_ScanId = WE_ScanId + 1
        for i = 1, #WE_Conns do
            WE_Conns[i]:Disconnect()
        end
        table.clear(WE_Conns)
        for i = 1, #WE_Prev do
            WE_Release(WE_Prev[i])
        end
        table.clear(WE_Prev)
        table.clear(WE_List)
        for _, cat in ipairs(WE_Cats) do
            table.clear(WE_Targets[cat])
        end
    end

    function WE_Sync()
        WE_C = WE_Config
        if WE_C.NPC or WE_C.Items or WE_C.Vehicle or WE_C.Custom then
            WE_Start()
        else
            WE_Stop()
        end
    end

    WE_RescanKeys = { NPC = true, Items = true, Vehicle = true, Custom = true, CustomName = true, CustomMode = true }
    WE_StyleKeys = { ShowChams = true, DepthMode = true, FillTransparency = true, OutlineTransparency = true }
    for _, cat in ipairs(WE_Cats) do
        WE_StyleKeys[cat .. "Fill"] = true
        WE_StyleKeys[cat .. "Outline"] = true
    end

    function WE_OnChange(key, value)
        if WE_Resetting then return end

        if key == "CustomName" then
            WE_CL = string.lower(value or "")
        elseif key == "NameBlacklist" then
            WE_ParseBlacklist()
        end

        if key == nil or WE_RescanKeys[key] then
            WE_Was = WE_Running
            WE_Sync()
            if WE_Was and WE_Running then
                WE_Rescan()
            end
        elseif WE_StyleKeys[key] then
            if WE_Running then WE_Restyle() end
        elseif WE_Running then
            WE_Rebuild()
        end
    end

    function WE_ResetAll()
        WE_Resetting = true
        for i = 1, #WE_Resets do
            WE_Resets[i]()
        end
        WE_Config.CustomName = ""
        WE_Config.NameBlacklist = ""
        pcall(function() WE_UI_Custom:Set("") end)
        pcall(function() WE_UI_Black:Set("") end)
        WE_Resetting = false

        WE_CL = ""
        WE_ParseBlacklist()
        WE_OnChange(nil, nil)
    end

    function WE_Reload()
        if WE_Running then
            WE_Rescan()
        end
    end

