--[[====[ Area > playerArea  ]== ]]
do
    PlayersService = PlayersService or game:GetService("Players")
    RunService = RunService or game:GetService("RunService")
    LocalPlayer = LocalPlayer or PlayersService.LocalPlayer

    function getHeadshotUrl(userId)
        return "rbxthumb://type=AvatarHeadShot&id=" .. tostring(userId) .. "&w=150&h=150"
    end

    function getListPlayer()
        names = { "None" }
        for _, p in ipairs(PlayersService:GetPlayers()) do
            if p ~= LocalPlayer then
                table.insert(names, p.Name)
            end
        end
        return names
    end

    function findPlayerByName(input)
        if not input or input == "" then
            return nil
        end

        input = string.lower(input)
        partial = nil

        for _, p in ipairs(PlayersService:GetPlayers()) do
            if p ~= LocalPlayer then
                pName = string.lower(p.Name)
                pDisplay = string.lower(p.DisplayName)

                if pName == input or pDisplay == input or tostring(p.UserId) == input then
                    return p
                end
                if not partial and (pName:sub(1, #input) == input or pDisplay:sub(1, #input) == input) then
                    partial = p
                end
            end
        end

        return partial
    end

    function copyUsername(player)
        if setclipboard then
            setclipboard(player.Name)
            WindUI:Notify({
                Title = "Success",
                Content = "Username '" .. player.Name .. "' copied to clipboard.",
                Duration = 2,
            })
        else
            WindUI:Notify({
                Title = "Error",
                Content = "setclipboard is not supported by this executor.",
                Duration = 2,
            })
        end
    end

    function drawTargetParagraph(section, oldParagraph, player, desc)
        if oldParagraph then
            pcall(function() oldParagraph:Destroy() end)
        end

        if not player then
            return section:Paragraph({
                Title = "No player selected",
                Desc = "Select a player from the dropdown to see info",
            })
        end

        return section:Paragraph({
            Title = "User: " .. player.Name .. ", Nick: " .. player.DisplayName .. " | ID: " .. tostring(player.UserId),
            Desc = desc,
            Image = getHeadshotUrl(player.UserId),
            ImageSize = 80,
            Buttons = {
                {
                    Icon = "clipboard",
                    Title = "Copy Username",
                    Callback = function()
                        copyUsername(player)
                    end,
                },
            },
        })
    end

    targetPlayer = nil       
    tpShown = nil            
    targetParagraph = nil
    playerDropdown = nil
    tpRefreshing = false

    SecTarget = TabHandles.playerArea:Section({
        Title = "Teleport Target",
        Box = true,
        TextXAlignment = "Left",
        TextSize = 17,
        Opened = false,
    })

    SecTeleports = TabHandles.playerArea:Section({
        Title = "Teleportation",
        Box = true,
        TextXAlignment = "Left",
        TextSize = 17,
        Opened = false,
    })

    function updateTargetTeleportInfo(player)
        targetPlayer = player
        if targetParagraph and tpShown == player then
            return
        end
        tpShown = player
        targetParagraph = drawTargetParagraph(SecTarget, targetParagraph, player, "Player targeted For Teleport")
    end

    updateTargetTeleportInfo(nil)

    playerDropdown = SecTeleports:Dropdown({
        Title = "Select Player",
        Values = getListPlayer(),
        Value = "None",
        Callback = function(selectedName)
            if tpRefreshing then return end

            if not selectedName or selectedName == "None" then
                updateTargetTeleportInfo(nil)
                return
            end

            found = PlayersService:FindFirstChild(selectedName)
            if found and found:IsA("Player") then
                updateTargetTeleportInfo(found)
            else
                updateTargetTeleportInfo(nil)
            end
        end,
    })

    SecTeleports:Input({
        Title = "Enter Username, Nickname, or User ID",
        Desc = "Automatically finds a matching player on the server.",
        Placeholder = "Enter here...",
        Callback = function(input)
            if not input or input == "" then
                updateTargetTeleportInfo(nil)
                if playerDropdown then
                    playerDropdown:Select("None")
                end
                return
            end

            found = findPlayerByName(input)
            if found then
                updateTargetTeleportInfo(found)
                if playerDropdown then
                    playerDropdown:Select(found.Name)
                end
            else
                WindUI:Notify({
                    Title = "Not Found",
                    Content = "Player '" .. input .. "' not found on this server",
                    Duration = 2,
                })
            end
