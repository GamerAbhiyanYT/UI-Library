do
    SecAutoClicker = TabHandles.combatArea:Section({
        Title = "Auto Clicker",
        Box = true,
        TextXAlignment = "Left",
        TextSize = 17,
        Opened = true,
    })

    if AC and AC.Stop then pcall(AC.Stop) end

    AC = {
        Enabled = false,
        Speed = 10,   -- clicks per second
        Range = 20,   -- studs
        Job = 0,      -- invalidates old loops so toggling quickly never stacks them
    }

    function AC.Stop()
        AC.Enabled = false
        AC.Job = AC.Job + 1
    end

    function AC.Tick()
        char = LocalPlayer.Character
        root = char and char:FindFirstChild("HumanoidRootPart")
        hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then return end

        tool = char:FindFirstChildOfClass("Tool")
        if not tool then return end

        rangeSq = AC.Range * AC.Range
        origin = root.Position
        targets = {}

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                tc = p.Character
                th = tc and tc:FindFirstChildOfClass("Humanoid")
                tr = tc and tc:FindFirstChild("HumanoidRootPart")
                if th and tr and th.Health > 0 then
                    d = tr.Position - origin
                    if d.X * d.X + d.Y * d.Y + d.Z * d.Z <= rangeSq then
                        targets[#targets + 1] = tr
                    end
                end
            end
        end

        if #targets == 0 then return end

        tool:Activate()

        handle = tool:FindFirstChild("Handle")
        if handle and firetouchinterest then
            for i = 1, #targets do
                firetouchinterest(handle, targets[i], 0)
                firetouchinterest(handle, targets[i], 1)
            end
        end
    end

    function AC.Start()
        AC.Stop()
        AC.Enabled = true
        myJob = AC.Job

        task.spawn(function()
            while AC.Enabled and AC.Job == myJob do
                pcall(AC.Tick)
                task.wait(1 / math.max(AC.Speed, 1))
            end
        end)
    end

    SecAutoClicker:Toggle({
        Title = "Enable Auto Clicker",
        Desc = "Automatically attacks every living player inside the set range using the tool you are holding. Equip a tool first.",
        Value = false,
        Callback = function(state)
            if state then AC.Start() else AC.Stop() end
        end
    })

