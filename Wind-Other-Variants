--[[=======[ Tracker > PlayerBox ]== ]]
do
    playerBoxes = TabHandles.playerBox:Section({ 
        Title = "Visual Tracker",
        Box = true,
        TextXAlignment = "Left",
        TextSize = 17,
        Opened = true,
    })
    
    
    BoxConfig = {
        Enabled = false,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
        FillColor = Color3.fromHex("#FF0000"),
        FillTransparency = 1,      
        OutlineColor = Color3.fromHex("#000000"),
        OutlineTransparency = 0,
        BoxSize = Vector3.new(4, 6, 2), 
        EdgeThickness = 0.12,
        FillRGB = false,
        OutlineRGB = false,
    }

    BoxDefaults = {
        DepthMode = BoxConfig.DepthMode,
        FillColor = BoxConfig.FillColor,
        FillTransparency = BoxConfig.FillTransparency,
        OutlineColor = BoxConfig.OutlineColor,
        OutlineTransparency = BoxConfig.OutlineTransparency,
        FillRGB = false,
        OutlineRGB = false,
    }
    
    container = Instance.new("Folder")
    container.Name = "AxparnBoxESP"
    pcall(function()
        container.Parent = (gethui and gethui()) or CoreGui
    end)
    if not container.Parent then
        container.Parent = workspace
    end
    
    -- [FIX BUG] Dulu `connections` global dan DITIMPA oleh blok Tracer ESP (nama sama),
    -- sehingga mematikan Box ESP ikut memutus koneksi Tracer. Sekarang local per blok.
    local entries = {}
    local connections = {}
    local playerConns = {}
    
    function isAlwaysOnTop()
        return BoxConfig.DepthMode == Enum.HighlightDepthMode.AlwaysOnTop
    end
    
    function applyStyle(entry)
        onTop = isAlwaysOnTop()
    
        if not BoxConfig.FillRGB then
            entry.fill.Color3 = BoxConfig.FillColor
        end
        entry.fill.Transparency = BoxConfig.FillTransparency
        entry.fill.AlwaysOnTop = onTop
        entry.fill.Size = BoxConfig.BoxSize
    
        for _, edge in ipairs(entry.edges) do
            if not BoxConfig.OutlineRGB then
                edge.Color3 = BoxConfig.OutlineColor
            end
            edge.Transparency = BoxConfig.OutlineTransparency
            edge.AlwaysOnTop = onTop
        end
    end
    
    RunService.RenderStepped:Connect(function()
        if not BoxConfig.Enabled then return end
    
        hasFillRGB = BoxConfig.FillRGB
        hasOutlineRGB = BoxConfig.OutlineRGB
    
        if not hasFillRGB and not hasOutlineRGB then return end
    
        hue = (tick() % 5) / 5
        fillRainbow = hasFillRGB and Color3.fromHSV(hue, 1, 1) or nil
        outlineRainbow = hasOutlineRGB and Color3.fromHSV((hue + 0.33) % 1, 1, 1) or nil
    
        for _, entry in pairs(entries) do
            if hasFillRGB and entry.fill then
                entry.fill.Color3 = fillRainbow
            end
            if hasOutlineRGB and entry.edges then
                for _, edge in ipairs(entry.edges) do
                    edge.Color3 = outlineRainbow
                end
            end
        end
    end)
    
    function newAdornment(root, zindex)
        a = Instance.new("BoxHandleAdornment")
        a.Adornee = root
        a.ZIndex = zindex
        a.Parent = container
        return a
    end
    
    function buildEdges(entry)
        s = BoxConfig.BoxSize
        t = BoxConfig.EdgeThickness
        hx, hy, hz = s.X / 2, s.Y / 2, s.Z / 2
        root = entry.root
    
        function addEdge(size, offset)
            e = newAdornment(root, 2)
            e.Size = size
            e.CFrame = CFrame.new(offset)
            table.insert(entry.edges, e)
        end
    
        for _, sy in ipairs({ -1, 1 }) do
            for _, sz in ipairs({ -1, 1 }) do
                addEdge(Vector3.new(s.X, t, t), Vector3.new(0, sy * hy, sz * hz))
            end
        end
        for _, sx in ipairs({ -1, 1 }) do
            for _, sz in ipairs({ -1, 1 }) do
                addEdge(Vector3.new(t, s.Y, t), Vector3.new(sx * hx, 0, sz * hz))
            end
        end
        for _, sx in ipairs({ -1, 1 }) do
            for _, sy in ipairs({ -1, 1 }) do
                addEdge(Vector3.new(t, t, s.Z), Vector3.new(sx * hx, sy * hy, 0))
            end
        end
    end
    
    function removeBox(player)
        entry = entries[player]
        if not entry then return end
        if entry.fill then entry.fill:Destroy() end
        for _, e in ipairs(entry.edges) do
            e:Destroy()
            end
            entries[player] = nil
    end
    
    function createBox(player, character)
        removeBox(player)
        if not character then return end
    
        root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)
        if not root or not BoxConfig.Enabled then return end
        if entries[player] then return end
    
        entry = { root = root, edges = {} }
        entry.fill = newAdornment(root, 1)
        buildEdges(entry)
        entries[player] = entry
        applyStyle(entry)
    end
    
    function disconnectPlayer(player)
        if playerConns[player] then
            for _, c in ipairs(playerConns[player]) do
                c:Disconnect()
            end
            playerConns[player] = nil
        end
    end
    
    function trackPlayer(player)
        if player == LocalPlayer then return end
        disconnectPlayer(player)
    
        playerConns[player] = {
            player.CharacterAdded:Connect(function(char)
                task.spawn(createBox, player, char)
            end),
            player.CharacterRemoving:Connect(function()
                removeBox(player)
            end),
        }
    
        if player.Character then
            task.spawn(createBox, player, player.Character)
        end
    end
    
    function enableBoxes()
        for _, player in ipairs(Players:GetPlayers()) do
            trackPlayer(player)
        end
        table.insert(connections, Players.PlayerAdded:Connect(trackPlayer))
        table.insert(connections, Players.PlayerRemoving:Connect(function(player)
            disconnectPlayer(player)
            removeBox(player)
        end))
    end
    
    function disableBoxes()
        for _, c in ipairs(connections) do
            c:Disconnect()
        end
        table.clear(connections)
    
        for player in pairs(playerConns) do
            disconnectPlayer(player)
        end
        for player in pairs(entries) do
            removeBox(player)
        end
    end
    
    function refreshBoxStyle()
        for _, entry in pairs(entries) do
            applyStyle(entry)
        end
    end
    
    function rebuildBoxes()
        if not BoxConfig.Enabled then return end
        disableBoxes()
        enableBoxes()
    end
    
    function setBoxesEnabled(state)
        if BoxConfig.Enabled == state then return end
        BoxConfig.Enabled = state
        if state then
            enableBoxes()
        else
            disableBoxes()
        end
    end
    
    boxesToggle = playerBoxes:Toggle({
        Title = "Enable Box",
        Desc = "Showing player highlights",
        Value = false,
        Callback = function(state)
            setBoxesEnabled(state)
        end
    })
    
    boxDepthDropdown = playerBoxes:Dropdown({
        Title = "DepthMode:",
        Desc = "Selecting the ESP type ",
        Values = { "AlwaysOnTop", "Occluded" },
        Value = "AlwaysOnTop",
        Callback = function(option)
            if option == "AlwaysOnTop" then
                BoxConfig.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            elseif option == "Occluded" then
                BoxConfig.DepthMode = Enum.HighlightDepthMode.Occluded
            end
            refreshBoxStyle()
        end
    })
    
    playerBoxes:Divider()
    
    fillBoxColor = playerBoxes:Colorpicker({
        Title = "Fill Line Color",
        Desc = "Fill in the box to be colored",
        Default = Color3.fromHex("#FF0000"),
        Transparency = 0,
        Locked = false,
        Callback = function(color)
            BoxConfig.FillColor = color
            refreshBoxStyle()
        end
    })
    
    fillBoxRGBToggle = playerBoxes:Toggle({
        Title = "Fill Line RGB Color",
        Desc = "Makes the fill color rainbow gradient",
        Value = false,
        Callback = function(state)
            BoxConfig.FillRGB = state
            refreshBoxStyle()
        end
    })
    
    outlineBoxColor = playerBoxes:Colorpicker({
        Title = "Outline Color",
        Desc = "Outline the box section to be colored",
        Default = Color3.fromHex("#000000"),
        Transparency = 0,
        Locked = false,
        Callback = function(color)
            BoxConfig.OutlineColor = color
            refreshBoxStyle()
        end
    })
    
    outlineBoxRGBToggle = playerBoxes:Toggle({
        Title = "Outline Line RGB Color",
        Desc = "Makes the outline color rainbow gradient",
        Value = false,
        Callback = function(state)
            BoxConfig.OutlineRGB = state
            refreshBoxStyle()
        end
    })
    
    playerBoxes:Divider()
    
    fillBoxParant = playerBoxes:Slider({
        Title = "Fill Transparancy",
        Desc = "total transparent highlight box",
        Step = 0.1,
        Value = {
            Min = 0,
            Max = 1,
            Default = 1,
        },
        Callback = function(value)
            BoxConfig.FillTransparency = value
            refreshBoxStyle()
        end
    })
    
    outlineBoxParant = playerBoxes:Slider({
        Title = "Outline Transparancy",
        Desc = "total transparent Outline highlight box",
        Step = 0.1,
        Value = {
            Min = 0,
            Max = 1,
            Default = 0, 
        },
        Callback = function(value)
            BoxConfig.OutlineTransparency = value
            refreshBoxStyle()
        end
    })
    
    boxesManagement = TabHandles.playerBox:Section({
        Title = "Preset Management",
        Box = true,
        TextXAlignment = "Left",
        TextSize = 17,
        Opened = true,
    })
    
    boxesManagement:Button({
        Title = "Reset to Default",
        Desc = "Restore Player ESP [ Box ] settings to default",
        Callback = function()
            BoxConfig.DepthMode = BoxDefaults.DepthMode
            BoxConfig.FillColor = BoxDefaults.FillColor
            BoxConfig.FillTransparency = BoxDefaults.FillTransparency
            BoxConfig.OutlineColor = BoxDefaults.OutlineColor
            BoxConfig.OutlineTransparency = BoxDefaults.OutlineTransparency
            BoxConfig.FillRGB = BoxDefaults.FillRGB
            BoxConfig.OutlineRGB = BoxDefaults.OutlineRGB
            refreshBoxStyle()
    
            pcall(function() boxDepthDropdown:Select("AlwaysOnTop") end)
            pcall(function() fillBoxColor:Set(BoxDefaults.FillColor, 0) end)
            pcall(function() fillBoxRGBToggle:SetValue(false) end)
            pcall(function() outlineBoxColor:Set(BoxDefaults.OutlineColor, 0) end)
            pcall(function() outlineBoxRGBToggle:SetValue(false) end)
            pcall(function() fillBoxParant:Set(BoxDefaults.FillTransparency) end)
            pcall(function() outlineBoxParant:Set(BoxDefaults.OutlineTransparency) end)
    
            WindUI:Notify({
                Title = "Success!",
                Content = "now back to the Default",
                Icon = "check",
                Duration = 2
            })
        end
    })
    
    boxesManagement:Button({
        Title = "Reload Settings",
        Desc = "refreshing Boxes for new players by manually",
        Callback = function()
            rebuildBoxes()
    
            WindUI:Notify({
                Title = "Success!",
                Content = "Boxes refreshed",
                Icon = "check",
                Duration = 2
            })
