    function SecProt.WaterStep(dt, char, root, result)
        char, root = SecProt.Parts()
        if not root then return end
        SecProt.Water.Params.FilterDescendantsInstances = { char }
        result = workspace:Raycast(root.Position, Vector3.new(0, -SecProt.Water.Range, 0), SecProt.Water.Params)
        if result and result.Material == Enum.Material.Water then
            SecProt.Water.Platform.CFrame = CFrame.new(root.Position.X, result.Position.Y - 0.5, root.Position.Z)
