    end

    CS_SaveAll = true
    CS_Ctl = {}
    CS_SaveCtl = {}
    CS_SaveAllCtl = nil
    CS_Planet = 196.2
    CS_Busy = false
    CS_Ready = false

    function CS_Notify(title, content, icon)
        WindUI:Notify({ Title = title, Content = content, Icon = icon or "check", Duration = 2 })
    end

    function CS_SetCtl(ctl, value)
        if not ctl then return end
        CS_Busy = true
        CS_SetOk = pcall(function() ctl:Set(value) end)
        if not CS_SetOk then
            pcall(function() ctl:SetValue(value) end)
        end
        CS_Busy = false
    end

    function CS_Apply(key, value)
        CS_Char = LocalPlayer.Character
        CS_Hum = CS_Char and CS_Char:FindFirstChildOfClass("Humanoid")

        if key == "WalkSpeed" then
            if CS_Hum then CS_Hum.WalkSpeed = value end
        elseif key == "JumpPower" then
            if CS_Hum then
                CS_Hum.UseJumpPower = true
                CS_Hum.JumpPower = value
            end
        elseif key == "FOV" then
            CS_Cam = Workspace.CurrentCamera
            if CS_Cam then CS_Cam.FieldOfView = value end
        elseif key == "Gravity" then
            Workspace.Gravity = value
        elseif key == "MaxZoom" then
