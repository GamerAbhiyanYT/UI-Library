        Desc = "Automatically rejoin the same game after being kicked or disconnected. Tries your server first, then any server if that fails.",
        Value = false,
        Callback = function(state)
            local GuiService = game:GetService("GuiService")
            local TS = game:GetService("TeleportService")

            AR.Enabled = false
            AR.Busy = false
            for _, c in ipairs(AR.Conns) do pcall(function() c:Disconnect() end) end
            table.clear(AR.Conns)

