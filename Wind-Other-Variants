--[[====[ searchEngine > ScLibrary ]===[ Scripts Library ]===[ TabHandles.ScLibrary ]===]]
do
    Axs = {
        Base = "https://scriptblox.com",
        PageSize = 6,        -- results per page (WindUI elements are heavy, keep it small)
        PreviewLimit = 6000, -- characters shown in the Code element (long scripts lag the highlighter)
        Query = "",
        Category = "All",
        Page = 1,
        HasNext = false,
        Busy = false,
        Items = {},
        Code = "",
        Title = "",
        EditReady = false,
    }

    function Axs.Notify(title, content, icon)
        WindUI:Notify({ Title = title, Content = content, Icon = icon or "check", Duration = 2 })
    end

    function Axs.Get(url, ok, res, req)
        ok, res = pcall(function()
            return game:HttpGet(url)
        end)
        if ok and type(res) == "string" and res ~= "" then
            return res
        end

        req = request or http_request or (syn and syn.request)
        if req then
            ok, res = pcall(req, { Url = url, Method = "GET" })
            if ok and res and type(res.Body) == "string" and res.Body ~= "" then
                return res.Body
            end
        end
        return nil
    end

    function Axs.Decode(body, ok, data)
        ok, data = pcall(function()
            return HttpService:JSONDecode(body)
        end)
        if ok then return data end
        return nil
    end

    -- Category -> API filters. "Universal Scripts" typed in the box = universal filter
    function Axs.Url(page, q, params, cat, low, endpoint)
        q = Axs.Query
        params = { "page=" .. page, "max=" .. Axs.PageSize }
        cat = Axs.Category

        if cat == "Universal" then
            params[#params + 1] = "universal=1"
        elseif cat == "Key" then
            params[#params + 1] = "key=1"
        elseif cat == "No Key" then
            params[#params + 1] = "key=0"
        elseif cat == "Free" then
            params[#params + 1] = "mode=free"
        end

        low = string.lower(q)
        if low == "universal" or low == "universal script" or low == "universal scripts" then
            params[#params + 1] = "universal=1"
            q = ""
        end

        endpoint = "/api/script/fetch"
        if q ~= "" then
            endpoint = "/api/script/search"
            params[#params + 1] = "q=" .. HttpService:UrlEncode(q)
        end

        return Axs.Base .. endpoint .. "?" .. table.concat(params, "&")
    end

    function Axs.Clear(i)
        for i = 1, #Axs.Items do
            pcall(function() Axs.Items[i]:Destroy() end)
        end
        Axs.Items = {}
    end

    function Axs.AddItem(cfg, p)
        p = SecResults:Paragraph(cfg)
        Axs.Items[#Axs.Items + 1] = p
        return p
    end

    function Axs.Status(title, desc)
        Axs.AddItem({ Title = title, Desc = desc })
    end

    -- full script code: from the search result, or fetched by slug when missing
    function Axs.GetCode(s, code, body, data)
        code = s.script
        if type(code) == "string" and code ~= "" then
            return code
        end
        if s.slug then
            body = Axs.Get(Axs.Base .. "/api/script/" .. tostring(s.slug))
            data = body and Axs.Decode(body)
            if data and type(data.script) == "table" and type(data.script.script) == "string" then
                return data.script.script
            end
        end
        return nil
    end

    function Axs.CopyFn(s)
        return function()
            task.spawn(function(code)
                code = Axs.GetCode(s)
                if not code then
                    Axs.Notify("Error", "Script code not available.", "alert-triangle")
                elseif not setclipboard then
                    Axs.Notify("Error", "setclipboard is not supported by this executor.", "alert-triangle")
                else
                    setclipboard(code)
                    Axs.Notify("Copied!", tostring(s.title or "Script"))
                end
            end)
        end
    end

    function Axs.ViewFn(s)
        return function()
            task.spawn(function(code, shown)
                code = Axs.GetCode(s)
                if not code then
                    Axs.Notify("Error", "Script code not available.", "alert-triangle")
                    return
                end

                Axs.Code = code
                Axs.Title = tostring(s.title or "Untitled")
                Axs.EditReady = false

                shown = code
                if #shown > Axs.PreviewLimit then
                    shown = string.sub(shown, 1, Axs.PreviewLimit)
                        .. "\n\n-- [preview truncated: " .. #code .. " characters in total."
                        .. " Use Load Into Editor or Copy Script for the full script]"
                end

                Axs.SetPreview(shown)
                pcall(function() Axs.EditUI:Set("") end)
                pcall(function() Axs.ViewLabel:SetTitle("Viewing: " .. Axs.Title) end)
                pcall(function() TabHandles.ScViewer:Select() end)
                Axs.Notify("Script loaded", Axs.Title)
            end)
        end
    end

    function Axs.Add(s, gm, name, img, tags, cfg, ok)
        gm = type(s.game) == "table" and s.game or {}
        name = tostring(gm.name or "Universal")

        tags = (s.key and "Key" or "No Key") .. " | " .. string.upper(tostring(s.scriptType or "free"))
        if s.isUniversal then tags = tags .. " | Universal" end
        if s.verified then tags = tags .. " | Verified" end
        if s.isPatched then tags = tags .. " | Patched" end
        if s.views then tags = tags .. " | Views: " .. tostring(s.views) end

        img = gm.imageUrl
        if type(img) == "string" and img ~= "" then
            if string.sub(img, 1, 4) ~= "http" then
                img = Axs.Base .. (string.sub(img, 1, 1) == "/" and "" or "/") .. img
            end
        else
            img = nil
        end

        cfg = {
            Title = tostring(s.title or "Untitled"),
            Desc = "Game: " .. name .. "\n" .. tags,
            ImageSize = 70,
            Buttons = {
                { Icon = "clipboard", Title = "Copy Script", Callback = Axs.CopyFn(s) },
                { Icon = "eye", Title = "View Script", Callback = Axs.ViewFn(s) },
            },
        }
        if img then cfg.Image = img end

        ok = pcall(Axs.AddItem, cfg)
        if not ok and img then
            cfg.Image = nil
            pcall(Axs.AddItem, cfg)
        end
    end

    function Axs.Work(page, url, body, data, list, i)
        Axs.Clear()
        Axs.Status("Searching...", "Loading page " .. page)

        url = Axs.Url(page)
        body = Axs.Get(url)
        if not body then
            Axs.Clear()
            Axs.Status("Request failed", "Could not reach ScriptBlox. Check your connection or executor HTTP support, then try again.")
            return
        end

        data = Axs.Decode(body)
        list = data and type(data.result) == "table" and data.result.scripts
        if type(list) ~= "table" then
            Axs.Clear()
            Axs.Status("Unexpected response", tostring(data and data.message or "ScriptBlox returned no script list."))
            return
        end

        Axs.HasNext = data.result.nextPage ~= nil or #list >= Axs.PageSize
        Axs.Clear()

        if #list == 0 then
            Axs.Status("No scripts found", "Try another keyword or category.")
        end

        for i = 1, #list do
            pcall(Axs.Add, list[i])
            task.wait() -- one paragraph per frame: no freeze while WindUI builds the element
        end

        pcall(function() Axs.PageLabel:SetTitle("Page: " .. Axs.Page) end)
    end

    function Axs.Search(page)
        if Axs.Busy then
            Axs.Notify("Please wait", "Still loading results...", "info")
            return
        end
        Axs.Busy = true
        Axs.Page = page

        task.spawn(function(ok, err)
            ok, err = pcall(Axs.Work, page)
            Axs.Busy = false
            if not ok then
                pcall(Axs.Clear)
                pcall(Axs.Status, "Error", tostring(err))
            end
        end)
    end

    function Axs.MakeCode(text, ok, ui)
        ok, ui = pcall(function()
            return SecViewer:Code({ Title = "Script Preview", Code = text, OnCopy = function() end })
        end)
        if not ok then
            ok, ui = pcall(function()
                return TabHandles.ScViewer:Code({ Title = "Script Preview", Code = text, OnCopy = function() end })
            end)
        end
        return ok and ui or nil
    end

    function Axs.SetPreview(text, ok)
        ok = Axs.CodeUI and pcall(function() Axs.CodeUI:SetCode(text) end)
        if not ok then
            if Axs.CodeUI then pcall(function() Axs.CodeUI:Destroy() end) end
            Axs.CodeUI = Axs.MakeCode(text)
        end
    end

    ---------------------------------------------------------------- Search UI
    SecSearch = TabHandles.ScLibrary:Section({
        Title = "Search Script",
        Box = true,
        TextXAlignment = "Left",
        TextSize = 17,
        Opened = true,
    })

    Axs.QueryUI = SecSearch:Input({
        Title = "Search Script or Game",
        Desc = "Type a game name or script name. Type \"Universal Scripts\" to list universal scripts.",
        Type = "Input",
        Placeholder = "Search Script or Game...",
        Callback = function(input)
            Axs.Query = tostring(input or "")
        end
    })

    SecSearch:Dropdown({
        Title = "Category",
        Desc = "All, Universal, Key, No Key or Free scripts",
        Values = { "All", "Universal", "Key", "No Key", "Free" },
        Value = "All",
        Callback = function(option)
            if type(option) == "table" then option = option[1] end
            Axs.Category = option or "All"
        end
    })

    SecSearch:Divider()

    SecSearch:Button({
        Title = "Search",
        Desc = "Search scripts with the text and category above",
        Icon = "search",
        Callback = function()
            Axs.Search(1)
        end
    })

    SecSearch:Button({
        Title = "Search Current Game",
        Desc = "Search scripts for the game you are playing: " .. tostring(gameName),
        Icon = "gamepad-2",
        Callback = function()
            Axs.Query = tostring(gameName)
            pcall(function() Axs.QueryUI:Set(Axs.Query) end)
            Axs.Search(1)
        end
    })

    SecPaging = TabHandles.ScLibrary:Section({
        Title = "Pages",
        Box = true,
        TextXAlignment = "Left",
        TextSize = 17,
        Opened = true,
    })

    Axs.PageLabel = SecPaging:Button({
        Title = "Page: 1",
        Desc = "Current result page",
    })

    SecPaging:Button({
        Title = "Previous Page",
        Icon = "chevron-left",
        Callback = function()
            if Axs.Page > 1 then
                Axs.Search(Axs.Page - 1)
            else
                Axs.Notify("Info", "Already on the first page.", "info")
            end
        end
    })

    SecPaging:Button({
        Title = "Next Page",
