-- ============================================================================
-- Liquid Glass FX  (native, no external model required)
--
--  1. Continuous reflection
--     Specular rim + full-surface sheen are drawn with the SAME squircle sprites
--     that WindUI uses for its panels, so the light follows every curve and every
--     corner without seams. One shared light angle is used by every panel, so the
--     window, the content panel and toasts all reflect the same light source.
--
--  2. Edge lens
--     A stack of inset squircle rings builds a glass "bevel" that is strongest on
--     the inner border of a panel and fades to nothing toward the centre
--     (centre = normal, un-magnified). When the cursor / finger crosses the border
--     the bevel swells (the band widens and brightens) and relaxes again as the
--     pointer moves toward the middle of the UI.
--     If the GlassmorphicUI module is installed and Liquid Glass mode is active,
--     the same swell also drives its RefractionFactor / Thickness (real refraction).
-- ============================================================================
local LiquidGlassFX = { Panels = {}, LightAngle = nil, SwellHook = nil }
do
    local fx = LiquidGlassFX
    local GuiService = af(game:GetService "GuiService")
    local RING_COUNT = 5
    local WHITE = Color3.new(1, 1, 1)
    local touchPos = nil
    local loopConn = nil
    local lastTick = 0
    local lightVec = nil
    local lastLightAngle = nil
    local inputConnected = false

    local function num(key, default, lo, hi)
        local v = tonumber(aa.LiquidGlassConfig[key])
        if v == nil then v = default end
        return math.clamp(v, lo, hi)
    end

    local function smooth(x)
        x = math.clamp(x, 0, 1)
        return x * x * (3 - 2 * x)
    end

    -- profile = { {time, opacity}, ... }  ->  NumberSequence of *transparency*
    local function seq(profile, scale)
        local keys = {}
        for _, p in ipairs(profile) do
            keys[#keys + 1] = NumberSequenceKeypoint.new(p[1], math.clamp(1 - p[2] * scale, 0, 1))
        end
        return NumberSequence.new(keys)
    end

    -- Bright at both light-facing ends of the gradient axis, dim in between.
    local RIM_PROFILE = { { 0, 1 }, { 0.16, 0.72 }, { 0.38, 0.14 }, { 0.62, 0.14 }, { 0.84, 0.72 }, { 1, 1 } }
    local SHEEN_PROFILE = { { 0, 0.10 }, { 0.12, 0.26 }, { 0.28, 0.07 }, { 0.5, 0 }, { 0.78, 0.04 }, { 0.92, 0.15 }, { 1, 0.07 } }
    -- Lens rings stay visible on all four sides (never fully dark), lit corners a bit stronger.
    local LENS_PROFILE = { { 0, 1 }, { 0.2, 0.82 }, { 0.4, 0.58 }, { 0.6, 0.58 }, { 0.8, 0.82 }, { 1, 1 } }

    local function deriveRadius(obj)
        local ok, scale = pcall(function()
            return obj.SliceScale
        end)
        if ok and type(scale) == "number" and obj:IsA("ImageLabel") and obj.ScaleType == Enum.ScaleType.Slice then
            return math.clamp(scale * 310, 4, 80)
        end
        local corner = obj:FindFirstChildOfClass("UICorner")
        if corner then
            return math.max(corner.CornerRadius.Offset, 4)
        end
        return 14
    end

    local function newLabel(parent, radius, shape, name, z)
        local label, ctl = as.NewRoundFrame(radius, shape, {
            Name = name,
            Size = UDim2.fromScale(1, 1),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            ZIndex = z or 1,
            ImageTransparency = 1,
        })
        label.Active = false
        label.Parent = parent
        return label, ctl
    end

    local function addGradient(label)
        local g = Instance.new("UIGradient")
        g.Parent = label
        return g
    end

    local function makeHolder(name, z, parent)
        local f = Instance.new("Frame")
        f.Name = name
        f.BackgroundTransparency = 1
        f.BorderSizePixel = 0
        f.Size = UDim2.fromScale(1, 1)
        f.ZIndex = z
        f.Active = false
        f.Parent = parent
        return f
    end

    local function destroyLayers(panel)
        if panel.Under then panel.Under:Destroy() end
        if panel.Over then panel.Over:Destroy() end
        panel.Under, panel.Over = nil, nil
        panel.Rings, panel.Fringes = {}, {}
    end

    local function build(panel)
        destroyLayers(panel)
        local radius = panel.Radius
        local under = makeHolder("LG_Under", panel.UnderZ, panel.Object)
        local over = makeHolder("LG_Over", panel.OverZ, panel.Object)
        panel.Under, panel.Over = under, over

        panel.Sheen, panel.SheenCtl = newLabel(under, radius, "Squircle", "LG_Sheen", 1)
        panel.SheenGrad = addGradient(panel.Sheen)

        panel.Edge, panel.EdgeCtl = newLabel(over, radius, "SquircleGlass", "LG_Edge", 1)
        panel.Rim, panel.RimCtl = newLabel(over, radius, "SquircleGlass", "LG_Rim", 2)
        panel.RimGrad = addGradient(panel.Rim)

        panel.Fringes = {}
        for i, color in ipairs({ Color3.fromRGB(255, 110, 150), Color3.fromRGB(110, 190, 255) }) do
            local label, ctl = newLabel(over, radius, "SquircleOutline", "LG_Fringe" .. i, 3)
            label.ImageColor3 = color
            panel.Fringes[i] = { Label = label, Ctl = ctl, Grad = addGradient(label), depth = -1 }
            panel.Fringes[i].Grad.Transparency = seq(LENS_PROFILE, 1)
        end

        panel.Rings = {}
        for i = 1, RING_COUNT do
            local label, ctl = newLabel(over, radius, "SquircleOutline", "LG_Ring" .. i, 1)
            local grad = addGradient(label)
            grad.Transparency = seq(LENS_PROFILE, 1)
            panel.Rings[i] = { Label = label, Ctl = ctl, Grad = grad, depth = -1, alpha = -1 }
        end
        panel.RingsDirty = true
    end

    local function applyAngle(panel, angle)
        if not panel.Over then return end
        panel.SheenGrad.Rotation = angle
        panel.RimGrad.Rotation = angle
        for _, ring in ipairs(panel.Rings) do ring.Grad.Rotation = angle end
        for _, fr in ipairs(panel.Fringes) do fr.Grad.Rotation = angle end
    end

    local function applySwell(panel, swell)
        if not panel.Over or not panel.LensOn then return end
        local scaleUI = aa.UIScale or 1
        local boost = panel.Reactive and swell or 0
        local depthMax = panel.Band * (1 + 0.9 * boost)
        local peak = math.clamp(panel.Strength * 0.45 * (1 + 0.8 * boost), 0, 0.9)
        local size = panel.Object.AbsoluteSize / scaleUI
        local limit = math.max(math.min(size.X, size.Y) / 2 - 2, 0)
        local force = panel.RingsDirty or swell <= 0 -- always land exactly on the resting look

        for i, ring in ipairs(panel.Rings) do
            local u = (i - 1) / (RING_COUNT - 1)
            local depth = u * depthMax
            local alpha = peak * (1 - u) ^ panel.Falloff
            local fits = depth <= limit
            if ring.Label.Visible ~= fits then ring.Label.Visible = fits end
            if fits then
                if force or math.abs(depth - ring.depth) > 0.05 then
                    ring.depth = depth
                    ring.Label.Size = UDim2.new(1, -2 * depth, 1, -2 * depth)
                    ring.Ctl:SetRadius(math.max(panel.Radius - depth, 2))
                end
                if force or math.abs(alpha - ring.alpha) > 0.003 then
                    ring.alpha = alpha
                    ring.Label.ImageTransparency = 1 - alpha
                end
            end
        end

        local ca = panel.CA * (0.6 + 0.8 * boost)
        for i, fr in ipairs(panel.Fringes) do
            local depth = (i == 1 and 0.5 or 2.6) * (1 + boost)
            fr.Label.Visible = ca > 0.001 and depth <= limit
            if force or math.abs(depth - fr.depth) > 0.05 then
                fr.depth = depth
                fr.Label.Size = UDim2.new(1, -2 * depth, 1, -2 * depth)
                fr.Ctl:SetRadius(math.max(panel.Radius - depth, 2))
            end
            fr.Label.ImageTransparency = 1 - math.clamp(0.45 * ca * (i == 1 and 1 or 0.8), 0, 0.8)
        end
        panel.RingsDirty = false
    end

    local function applyConfig(panel)
        if not panel.Over or not panel.Over.Parent then return end
        local config = aa.LiquidGlassConfig
        local radius = panel.RadiusFn and panel.RadiusFn() or panel.Radius
        radius = math.max(tonumber(radius) or 14, 2)

        local enabled = config.Enabled ~= false
        local reflect = enabled and config.Reflection ~= false
        local I = num("ReflectionIntensity", 70, 0, 100) / 100
        local S = num("ReflectionSheen", 35, 0, 100) / 100
        local tint = typeof(config.Tint) == "Color3" and config.Tint or WHITE
        local light = tint:Lerp(WHITE, 0.6)

        if panel.Radius ~= radius then
            panel.Radius = radius
            panel.SheenCtl:SetRadius(radius)
            panel.EdgeCtl:SetRadius(radius)
            panel.RimCtl:SetRadius(radius)
            panel.RingsDirty = true
        end

        -- reflection ---------------------------------------------------------
        panel.Under.Visible = reflect and S > 0.001
        panel.Sheen.ImageColor3 = light
        panel.Sheen.ImageTransparency = 0
        panel.SheenGrad.Transparency = seq(SHEEN_PROFILE, S)

        panel.Edge.Visible = reflect and I > 0.001
        panel.Edge.ImageColor3 = light
        panel.Edge.ImageTransparency = 1 - math.clamp(0.2 * I, 0, 1)
        panel.Rim.Visible = reflect and I > 0.001
        panel.Rim.ImageColor3 = light
        panel.Rim.ImageTransparency = 0
        panel.RimGrad.Transparency = seq(RIM_PROFILE, I)

        -- lens ---------------------------------------------------------------
        panel.LensOn = enabled and config.LensEnabled ~= false and panel.Lens ~= false
        panel.Band = num("LensBand", 26, 4, 80) * (panel.BandScale or 1)
        panel.Strength = num("LensStrength", 65, 0, 100) / 100
        panel.Falloff = num("LensFalloff", 2, 1, 4)
        panel.Reactive = config.LensReactive ~= false
        panel.CA = num("ChromaticAberration", 0.12, 0, 1)
        for _, ring in ipairs(panel.Rings) do
            ring.Label.ImageColor3 = light
            if not panel.LensOn then ring.Label.Visible = false end
        end
        for _, fr in ipairs(panel.Fringes) do
            if not panel.LensOn then fr.Label.Visible = false end
        end

        if panel.Kind == "window" then
            local window = aa.Window
            if window and window.AcrylicPaint and window.AcrylicPaint.SetRadius then
                window.AcrylicPaint.SetRadius(radius)
            end
        end

        applyAngle(panel, fx.LightAngle or num("ReflectionAngle", 45, -360, 360))
        applySwell(panel, panel.Swell)
    end

    -- pointer --------------------------------------------------------------
    local function samplePointer()
        if touchPos then return touchPos end
        if an.MouseEnabled then return an:GetMouseLocation() end
        return nil
    end

    -- 1 on the inner border (and just outside it), easing to 0 toward the centre.
    local function proximity(panel, p, scaleUI)
        if not p then return 0 end
        local pos, size = panel.Object.AbsolutePosition, panel.Object.AbsoluteSize
        if size.X < 2 or size.Y < 2 then return 0 end
        local d = math.min(p.X - pos.X, pos.X + size.X - p.X, p.Y - pos.Y, pos.Y + size.Y - p.Y)
        local reach = math.max(panel.Band * scaleUI * 1.6, 8)
        if d >= 0 then
            return 1 - smooth(d / reach)
        end
        return smooth(1 + d / (reach * 0.5))
    end

    local function step(dt)
        local config = aa.LiquidGlassConfig
        local p = samplePointer()
        local scaleUI = aa.UIScale or 1
        local settled = true
        local now = os.clock()
        local mainPanel = nil

        for _, panel in pairs(fx.Panels) do
            if panel.Kind == "window" then mainPanel = panel end
            if panel.Over and panel.LensOn then
                local target = panel.Reactive and proximity(panel, p, scaleUI) or 0
                local k = 1 - math.exp(-dt * 14)
                local value = panel.Swell + (target - panel.Swell) * k
                if math.abs(target - value) < 0.002 then value = target end
                if value ~= panel.Swell then
                    panel.Swell = value
                    applySwell(panel, value)
                end
                if value ~= target then settled = false end

                if panel.Kind == "window" and fx.SwellHook
                    and math.abs(value - (panel.HookSwell or 0)) > 0.03
                    and now - (panel.HookClock or 0) > 0.08 then
                    panel.HookSwell, panel.HookClock = value, now
                    fx.SwellHook(panel, value)
                end
            end
        end

        -- optional: the light source follows the pointer (shared by every panel)
        if config.LightFollowsPointer and mainPanel and p and mainPanel.Object.AbsoluteSize.X > 2 then
            local center = mainPanel.Object.AbsolutePosition + mainPanel.Object.AbsoluteSize / 2
            local v = p - center
            if v.Magnitude > 1 then
                local a2 = math.atan2(v.Y, v.X) * 2 -- doubled angle: gradient is symmetric by 180 degrees
                local target = Vector2.new(math.cos(a2), math.sin(a2))
                local k = 1 - math.exp(-dt * 8)
                lightVec = lightVec and lightVec:Lerp(target, k) or target
                local angle = math.deg(math.atan2(lightVec.Y, lightVec.X)) / 2
                fx.LightAngle = angle
                if not lastLightAngle or math.abs(angle - lastLightAngle) > 0.1 then
                    lastLightAngle = angle
                    for _, panel in pairs(fx.Panels) do applyAngle(panel, angle) end
                    settled = false
                end
            end
        end
        return settled
    end

    local function kick()
        if loopConn or next(fx.Panels) == nil then return end
        lastTick = os.clock()
        loopConn = am.Heartbeat:Connect(function()
            local now = os.clock()
            local dt = math.min(now - lastTick, 0.1)
            lastTick = now
            if step(dt) and loopConn then
                loopConn:Disconnect()
                loopConn = nil
            end
        end)
    end

    local function connectInput()
        if inputConnected then return end
        inputConnected = true
        local function touchPosition(input)
            return Vector2.new(input.Position.X, input.Position.Y) + GuiService:GetGuiInset()
        end
        an.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                kick()
            elseif input.UserInputType == Enum.UserInputType.Touch then
                touchPos = touchPosition(input)
                kick()
            end
        end)
        an.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                touchPos = touchPosition(input)
                kick()
            end
        end)
        an.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                touchPos = nil
                kick()
            end
        end)
    end

    -- public ---------------------------------------------------------------
    -- opts: Kind ("window" | "panel" | "toast"), Radius (number or function),
    --       Lens (false disables the edge lens), BandScale, UnderZ, OverZ
    function fx.Attach(obj, opts)
        if typeof(obj) ~= "Instance" or not obj:IsA("GuiObject") then return nil end
        if fx.Panels[obj] then return fx.Panels[obj] end
        opts = opts or {}
