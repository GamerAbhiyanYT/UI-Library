function Elements.Colorpicker(parent, cfg)
    cfg = cfg or {}
    local currentColor = cfg.Default or Color3.fromHex("#0091FF")
    local h, s, v = Color3.toHSV(currentColor)
    local opened = false

    local base = CreateElementCard(parent, {
