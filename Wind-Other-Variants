                CH.RS = game:GetService("RunService")
                CH.Params = RaycastParams.new()
                CH.Params.FilterType = Enum.RaycastFilterType.Exclude
                CH.Acc = 0
                CH.Parts = {}
                CH.Strokes = {}
    
                -- ===== GUI =====
                CH.Gui = Instance.new("ScreenGui")
                CH.Gui.Name = "AxparnCrosshair"
                CH.Gui.IgnoreGuiInset = true
                CH.Gui.ResetOnSpawn = false
                CH.Gui.DisplayOrder = 2147483647
                CH.Gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
                pcall(function()
                    CH.Gui.Parent = (gethui and gethui()) or game:GetService("CoreGui")
                end)
                if not CH.Gui.Parent then
                    CH.Gui.Parent = CH.Player:WaitForChild("PlayerGui")
                end
    
                CH.Box = Instance.new("Frame")
                CH.Box.Name = "Crosshair"
                CH.Box.AnchorPoint = Vector2.new(0.5, 0.5)
                CH.Box.Position = UDim2.fromScale(0.5, 0.5)
                CH.Box.BackgroundTransparency = 1
                CH.Box.BorderSizePixel = 0
                CH.Box.Active = false
                CH.Box.Parent = CH.Gui
    
                -- ===== Primitif gambar (koordinat dari titik tengah) =====
                CH.Line = function(x1, y1, x2, y2)
                    CH.Dx, CH.Dy = x2 - x1, y2 - y1
                    CH.Len = math.sqrt(CH.Dx * CH.Dx + CH.Dy * CH.Dy)
                    CH.F = Instance.new("Frame")
                    CH.F.AnchorPoint = Vector2.new(0.5, 0.5)
                    CH.F.Size = UDim2.fromOffset(CH.Len + 0.5, CH.T)
                    CH.F.Position = UDim2.fromOffset(CH.Half + (x1 + x2) / 2, CH.Half + (y1 + y2) / 2)
                    CH.F.Rotation = math.deg(math.atan2(CH.Dy, CH.Dx))
                    CH.F.BorderSizePixel = 0
                    CH.F.Active = false
                    CH.F.Parent = CH.Box
                    table.insert(CH.Parts, { CH.F, 1 })
                end
    
                CH.Dot = function(x, y, d)
                    CH.F = Instance.new("Frame")
                    CH.F.AnchorPoint = Vector2.new(0.5, 0.5)
                    CH.F.Size = UDim2.fromOffset(d, d)
                    CH.F.Position = UDim2.fromOffset(CH.Half + x, CH.Half + y)
                    CH.F.BorderSizePixel = 0
                    CH.F.Active = false
                    CH.F.Parent = CH.Box
                    CH.Cr = Instance.new("UICorner")
                    CH.Cr.CornerRadius = UDim.new(1, 0)
                    CH.Cr.Parent = CH.F
                    table.insert(CH.Parts, { CH.F, 1 })
                end
    
                CH.Ring = function(radius, filled)
                    CH.F = Instance.new("Frame")
                    CH.F.AnchorPoint = Vector2.new(0.5, 0.5)
                    CH.F.Size = UDim2.fromOffset(radius * 2, radius * 2)
                    CH.F.Position = UDim2.fromOffset(CH.Half, CH.Half)
                    CH.F.BackgroundTransparency = 1
                    CH.F.BorderSizePixel = 0
                    CH.F.Active = false
                    CH.F.Parent = CH.Box
                    CH.Cr = Instance.new("UICorner")
                    CH.Cr.CornerRadius = UDim.new(1, 0)
                    CH.Cr.Parent = CH.F
                    CH.St = Instance.new("UIStroke")
                    CH.St.Thickness = CH.T
                    CH.St.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                    CH.St.Parent = CH.F
                    table.insert(CH.Strokes, CH.St)
                    if filled then
                        table.insert(CH.Parts, { CH.F, 0.35 })
                    end
                end
    
                CH.Arc = function(radius, a1, a2)
                    CH.N = math.max(1, math.ceil((a2 - a1) / 10))
                    for i = 0, CH.N - 1 do
                        CH.A1 = math.rad(a1 + (a2 - a1) * i / CH.N)
                        CH.A2 = math.rad(a1 + (a2 - a1) * (i + 1) / CH.N)
                        CH.Line(math.cos(CH.A1) * radius, math.sin(CH.A1) * radius, math.cos(CH.A2) * radius, math.sin(CH.A2) * radius)
                    end
                end
    
                CH.PolyPts = function(radius, start, n)
                    CH.Pts = {}
                    for i = 0, n - 1 do
                        CH.Ang = math.rad(start + 360 * i / n)
                        table.insert(CH.Pts, { math.cos(CH.Ang) * radius, math.sin(CH.Ang) * radius })
                    end
                    return CH.Pts
                end
    
                CH.Poly = function(radius, start, n)
                    CH.P = CH.PolyPts(radius, start, n)
                    for i = 1, n do
                        CH.Nx = CH.P[i % n + 1]
                        CH.Line(CH.P[i][1], CH.P[i][2], CH.Nx[1], CH.Nx[2])
                    end
                end
    
                CH.Plus = function(g, e)
                    CH.Line(0, -e, 0, -g)
                    CH.Line(0, g, 0, e)
                    CH.Line(-e, 0, -g, 0)
                    CH.Line(g, 0, e, 0)
                end
    
                CH.Spoke = function(angle, a, b)
                    CH.Rad = math.rad(angle)
                    CH.Line(math.cos(CH.Rad) * a, math.sin(CH.Rad) * a, math.cos(CH.Rad) * b, math.sin(CH.Rad) * b)
                end
    
                -- ===== Daftar bentuk (r = setengah ukuran) =====
                CH.Shapes = {
                    ["Default (dot)"] = function(r)
                        CH.Dot(0, 0, CH.T * 2)
                    end,
                    ["Plus"] = function(r)
                        CH.Plus(r * 0.2, r)
                    end,
                    ["Plus (Gap)"] = function(r)
                        CH.Plus(r * 0.5, r)
                    end,
                    ["Plus + Dot"] = function(r)
                        CH.Plus(r * 0.35, r)
                        CH.Dot(0, 0, CH.T * 1.6)
                    end,
                    ["Cross X"] = function(r)
                        for _, sx in ipairs({ -1, 1 }) do
                            for _, sy in ipairs({ -1, 1 }) do
                                CH.Line(sx * r * 0.2, sy * r * 0.2, sx * r * 0.7, sy * r * 0.7)
                            end
                        end
                    end,
                    ["Circle"] = function(r)
                        CH.Ring(r - CH.T)
                    end,
                    ["Circle + Dot"] = function(r)
                        CH.Ring(r - CH.T)
                        CH.Dot(0, 0, CH.T * 1.6)
                    end,
                    ["Circle (Filled)"] = function(r)
                        CH.Ring(r - CH.T, true)
                        CH.Dot(0, 0, CH.T * 1.6)
                    end,
                    ["Circle (Broken)"] = function(r)
                        for k = 0, 3 do
                            CH.Arc(r - CH.T, k * 90 + 15, k * 90 + 75)
                        end
                    end,
                    ["Circle + Ticks"] = function(r)
                        CH.Ring(r * 0.62)
                        CH.Line(0, -r * 0.45, 0, -r * 0.85)
                        CH.Line(0, r * 0.45, 0, r * 0.85)
                        CH.Line(-r * 0.45, 0, -r * 0.85, 0)
                        CH.Line(r * 0.45, 0, r * 0.85, 0)
                    end,
                    ["Triangle"] = function(r)
                        CH.Poly(r * 0.85, -90, 3)
                    end,
                    ["Triangle + Dot"] = function(r)
                        CH.Poly(r * 0.85, -90, 3)
                        CH.Dot(0, 0, CH.T * 1.6)
                    end,
                    ["Triangle (Inverted)"] = function(r)
                        CH.Poly(r * 0.85, 90, 3)
                    end,
                    ["Triangle Corners"] = function(r)
                        CH.V = CH.PolyPts(r * 0.9, -90, 3)
                        for i = 1, 3 do
                            CH.Nb = { CH.V[i % 3 + 1], CH.V[(i + 1) % 3 + 1] }
                            for _, nb in ipairs(CH.Nb) do
                                CH.Line(CH.V[i][1], CH.V[i][2],
                                    CH.V[i][1] + (nb[1] - CH.V[i][1]) * 0.3,
                                    CH.V[i][2] + (nb[2] - CH.V[i][2]) * 0.3)
                            end
                        end
                    end,
                    ["Three Dots"] = function(r)
                        for _, p in ipairs(CH.PolyPts(r * 0.5, -90, 3)) do
                            CH.Dot(p[1], p[2], CH.T * 1.6)
                        end
                    end,
                    ["Y Shape"] = function(r)
                        CH.Spoke(90, r * 0.2, r * 0.85)
                        CH.Spoke(210, r * 0.2, r * 0.85)
                        CH.Spoke(330, r * 0.2, r * 0.85)
                    end,
                    ["Tripod"] = function(r)
                        CH.Spoke(-90, r * 0.2, r * 0.85)
                        CH.Spoke(30, r * 0.2, r * 0.85)
                        CH.Spoke(150, r * 0.2, r * 0.85)
                    end,
                    ["Corner Brackets"] = function(r)
                        for _, sx in ipairs({ -1, 1 }) do
                            for _, sy in ipairs({ -1, 1 }) do
                                CH.Line(sx * r * 0.8, sy * r * 0.8, sx * r * 0.45, sy * r * 0.8)
                                CH.Line(sx * r * 0.8, sy * r * 0.8, sx * r * 0.8, sy * r * 0.45)
                            end
                        end
                    end,
                    ["Chevrons"] = function(r)
                        CH.Line(-r * 0.8, -r * 0.3, -r * 0.45, 0)
                        CH.Line(-r * 0.45, 0, -r * 0.8, r * 0.3)
                        CH.Line(r * 0.8, -r * 0.3, r * 0.45, 0)
                        CH.Line(r * 0.45, 0, r * 0.8, r * 0.3)
                    end,
                    ["Dashes"] = function(r)
                        CH.Line(-r, 0, -r * 0.3, 0)
                        CH.Line(r * 0.3, 0, r, 0)
                    end,
                    ["Diamond"] = function(r)
                        CH.Poly(r * 0.8, 0, 4)
                    end,
                    ["Square"] = function(r)
                        CH.Poly(r * 0.95, 45, 4)
                    end,
                }
    
                -- ===== Warna =====
                CH.Paint = function(color, trans)
                    for _, p in ipairs(CH.Parts) do
                        p[1].BackgroundColor3 = color
                        p[1].BackgroundTransparency = 1 - (1 - trans) * p[2]
                    end
                    for _, s in ipairs(CH.Strokes) do
                        s.Color = color
                        s.Transparency = trans
                    end
                end
    
                -- ===== Gambar ulang sesuai bentuk & ukuran =====
                CH.Draw = function()
                    CH.Box:ClearAllChildren()
                    CH.Parts = {}
                    CH.Strokes = {}
                    CH.S = CH.Size
                    CH.Half = CH.S / 2
                    CH.T = math.clamp(math.floor(CH.S / 20) + 1, 2, 5)
                    CH.Box.Size = UDim2.fromOffset(CH.S, CH.S)
                    CH.Fn = CH.Shapes[CH.Shape] or CH.Shapes["Default (dot)"]
                    CH.Fn(CH.Half)
                    CH.LastC = nil
                end
    
                CH.Draw()
    
                -- ===== Loop: warna (RGB / hit) + deteksi pemain di tengah layar =====
                CH.Conn = CH.RS.RenderStepped:Connect(function(dt)
                    if not CH.Enabled then return end
    
                    if CH.HitOn then
                        CH.Acc = CH.Acc + dt
                        if CH.Acc >= 0.05 then
                            CH.Acc = 0
                            CH.Hit = false
                            CH.Cam = workspace.CurrentCamera
                            if CH.Cam then
                                CH.Params.FilterDescendantsInstances = { CH.Player.Character }
                                CH.Vp = CH.Cam.ViewportSize
                                CH.Ray = CH.Cam:ViewportPointToRay(CH.Vp.X / 2, CH.Vp.Y / 2)
                                CH.Res = workspace:Raycast(CH.Ray.Origin, CH.Ray.Direction * 1000, CH.Params)
                                if CH.Res then
                                    CH.Obj = CH.Res.Instance
                                    while CH.Obj and CH.Obj ~= workspace do
                                        CH.Pl = CH.Players:GetPlayerFromCharacter(CH.Obj)
                                        if CH.Pl then
                                            CH.Hit = CH.Pl ~= CH.Player
                                            break
                                        end
                                        CH.Obj = CH.Obj.Parent
                                    end
                                end
                            end
                        end
                    else
                        CH.Hit = false
                    end
    
                    CH.PA = (CH.PA or 0) + dt
                    if CH.RGB and not (CH.HitOn and CH.Hit) then
                        if CH.PA < 0.033 then return end
                    end
                    CH.PA = 0

                    if CH.HitOn and CH.Hit then
                        CH.C, CH.Tr = CH.HitColor, CH.HitTrans
                    elseif CH.RGB then
                        CH.C, CH.Tr = Color3.fromHSV((os.clock() * 0.25) % 1, 1, 1), CH.Trans
                    else
                        CH.C, CH.Tr = CH.Color, CH.Trans
                    end
    
                    if CH.C ~= CH.LastC or CH.Tr ~= CH.LastT then
                        CH.Paint(CH.C, CH.Tr)
                        CH.LastC, CH.LastT = CH.C, CH.Tr
                    end
                end)
            else
                if not CH.Enabled then return end
                CH.Enabled = false
                if CH.Conn then CH.Conn:Disconnect() CH.Conn = nil end
                if CH.Gui then CH.Gui:Destroy() CH.Gui = nil end
                CH.Draw = nil
            end
        end
    })
    
