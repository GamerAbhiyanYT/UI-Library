--[[=======[ Tracker > PlayerCham ]== ]]
do

    playerChams = TabHandles.playerCham:Section({ 
        Title = "Visual Tracker",
        Box = true,
        TextXAlignment = "Left",
        TextSize = 17,
        Opened = true,
    })
    
    
    ChamsConfig = {
        Enabled = false,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
        FillColor = Color3.fromHex("#EE0000"),
        OutlineColor = Color3.fromHex("#000000"),
        FillTransparency = 0.5,
        OutlineTransparency = 0,
        FillRGB = false,
        OutlineRGB = false,
    }

    ActiveHighlights = {}
    
    function applyChamsStyle(highlight)
        if not highlight then return end
        highlight.DepthMode = ChamsConfig.DepthMode
    
        if not ChamsConfig.FillRGB then
            highlight.FillColor = ChamsConfig.FillColor
        end
        if not ChamsConfig.OutlineRGB then
            highlight.OutlineColor = ChamsConfig.OutlineColor
        end
    
        highlight.FillTransparency = ChamsConfig.Enabled and ChamsConfig.FillTransparency or 1
        highlight.OutlineTransparency = ChamsConfig.Enabled and ChamsConfig.OutlineTransparency or 1
        highlight.Enabled = ChamsConfig.Enabled
    end
    
    function refreshChamsStyle()
        for _, highlight in pairs(ActiveHighlights) do
            applyChamsStyle(highlight)
        end
    end
    
    RunService.RenderStepped:Connect(function()
        if not ChamsConfig.Enabled then return end
    
        chamsHasFillRGB = ChamsConfig.FillRGB
        chamsHasOutlineRGB = ChamsConfig.OutlineRGB
    
        if not chamsHasFillRGB and not chamsHasOutlineRGB then return end
    
        chamsHue = (tick() % 5) / 5
        chamsFillRainbow = chamsHasFillRGB and Color3.fromHSV(chamsHue, 1, 1) or nil
        chamsOutlineRainbow = chamsHasOutlineRGB and Color3.fromHSV((chamsHue + 0.33) % 1, 1, 1) or nil
        
        for _, highlight in pairs(ActiveHighlights) do
            if chamsHasFillRGB then
                highlight.FillColor = chamsFillRainbow
            end
            if chamsHasOutlineRGB then
                highlight.OutlineColor = chamsOutlineRainbow
            end
        end
    end)
    
    -- [FIX LAG/LEAK] Simpan koneksi per player supaya "Reload Settings" tidak menumpuk koneksi
    -- (sebelumnya tiap Reload menambah 1 koneksi CharacterAdded per player -> highlight dobel tiap respawn),
    -- dan bersihkan highlight lama saat karakter dihapus (dulu tabel ActiveHighlights terus membengkak).
    ChamsConns = {}

    function addChams(player)
        if player == LocalPlayer then return end

        if ChamsConns[player] then
            for _, c in ipairs(ChamsConns[player]) do c:Disconnect() end
            ChamsConns[player] = nil
        end

        local function dropChams(character)
            if character and ActiveHighlights[character] then
                pcall(function() ActiveHighlights[character]:Destroy() end)
                ActiveHighlights[character] = nil
            end
        end

        local function onChamsCharacterAdded(character)
            dropChams(character)

            local chamsHighlight = Instance.new("Highlight")
            chamsHighlight.Name = "WindUI_Chams"
            applyChamsStyle(chamsHighlight)
            chamsHighlight.Adornee = character
            chamsHighlight.Parent = character

            ActiveHighlights[character] = chamsHighlight
        end

        if player.Character then
            onChamsCharacterAdded(player.Character)
        end
        ChamsConns[player] = {
            player.CharacterAdded:Connect(onChamsCharacterAdded),
            player.CharacterRemoving:Connect(dropChams),
        }
    end

    function removeChams(player)
        if ChamsConns[player] then
            for _, c in ipairs(ChamsConns[player]) do c:Disconnect() end
            ChamsConns[player] = nil
        end
        if player.Character and ActiveHighlights[player.Character] then
            pcall(function() ActiveHighlights[player.Character]:Destroy() end)
            ActiveHighlights[player.Character] = nil
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        addChams(player)
    end
    Players.PlayerAdded:Connect(addChams)
    Players.PlayerRemoving:Connect(removeChams)

    function setChamsEnabled(state)
        ChamsConfig.Enabled = state
        refreshChamsStyle()
    end
    
    chamsToggle = playerChams:Toggle({
        Title = "Enable Chams",
        Desc = "Showing player highlights",
        Value = false,
        Callback = function(state)
            setChamsEnabled(state)
        end
    })
    
    chamsDepthDropdown = playerChams:Dropdown({
        Title = "DepthMode:",
        Desc = "Selecting the ESP type ",
        Values = { "AlwaysOnTop", "Occluded" },
        Value = "AlwaysOnTop",
        Callback = function(option) 
            if option == "AlwaysOnTop" then
                ChamsConfig.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            elseif option == "Occluded" then
                ChamsConfig.DepthMode = Enum.HighlightDepthMode.Occluded
            end
            refreshChamsStyle()
        end
    })
    
    playerChams:Divider()
    
    fillChamsColor = playerChams:Colorpicker({
        Title = "Fill Color",
        Desc = "Highlight color of the inner part of the character",
        Default = Color3.fromHex("#EE0000"),
        Transparency = 0,
        Locked = false,
        Callback = function(color)
            ChamsConfig.FillColor = color
            refreshChamsStyle()
        end
    })
    
    fillChamsRGBToggle = playerChams:Toggle({
        Title = "Fill RGB Color",
        Desc = "Makes the fill color rainbow gradient",
        Value = false,
        Callback = function(state)
            ChamsConfig.FillRGB = state
            refreshChamsStyle()
        end
    })
    
    outlineChamColor = playerChams:Colorpicker({
        Title = "Outline Color",
        Desc = "Highlight color of the outline of the character",
        Default = Color3.fromHex("#000000"),
        Transparency = 0,
        Locked = false,
        Callback = function(color)
            ChamsConfig.OutlineColor = color
            refreshChamsStyle()
        end
    })
    
    outlineChamsRGBToggle = playerChams:Toggle({
        Title = "Outline RGB Color",
        Desc = "Makes the outline color rainbow gradient",
        Value = false,
        Callback = function(state)
            ChamsConfig.OutlineRGB = state
            refreshChamsStyle()
