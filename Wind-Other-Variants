        end
    })

    SecResults = TabHandles.ScLibrary:Section({
        Title = "Results",
        Box = true,
        TextXAlignment = "Left",
        TextSize = 17,
        Opened = true,
    })

    Axs.Status("No results yet", "Type a script or game name, choose a category, then press Search.")

    ---------------------------------------------------------------- Viewer UI
    SecViewer = TabHandles.ScViewer:Section({
        Title = "Script Viewer",
        Box = true,
        TextXAlignment = "Left",
        TextSize = 17,
        Opened = true,
    })

    Axs.ViewLabel = SecViewer:Button({
        Title = "No script opened",
        Desc = "Press View Script on a result in Scripts Library",
    })

    Axs.CodeUI = Axs.MakeCode("-- no script opened yet")

    SecEdit = TabHandles.ScViewer:Section({
        Title = "Edit & Run",
        Box = true,
        TextXAlignment = "Left",
        TextSize = 17,
        Opened = true,
    })

    Axs.EditUI = SecEdit:Input({
        Title = "Edit Script",
        Desc = "Press Load Into Editor first, edit the script, then tap outside the box so it is saved.",
        Type = "Textarea",
        Placeholder = "Load a script into the editor...",
        Callback = function(input)
            if Axs.EditReady then
                Axs.Code = tostring(input or "")
            end
        end
    })

    SecEdit:Button({
        Title = "Load Into Editor",
        Desc = "Put the full script in the edit box (long scripts may take a moment)",
        Icon = "pencil",
        Callback = function()
            if Axs.Code == "" then
                Axs.Notify("Error", "Open a script with View Script first.", "alert-triangle")
                return
            end
            Axs.EditReady = false
            pcall(function() Axs.EditUI:Set(Axs.Code) end)
            task.delay(0.5, function() Axs.EditReady = true end)
        end
    })

    SecEdit:Button({
        Title = "Copy Script",
        Desc = "Copy the opened (or edited) script",
        Icon = "clipboard",
        Callback = function()
            if Axs.Code == "" then
                Axs.Notify("Error", "No script opened.", "alert-triangle")
            elseif not setclipboard then
                Axs.Notify("Error", "setclipboard is not supported by this executor.", "alert-triangle")
            else
                setclipboard(Axs.Code)
                Axs.Notify("Copied!", Axs.Title)
            end
        end
    })

    SecEdit:Button({
        Title = "Execute Script",
        Desc = "Run the opened (or edited) script",
        Icon = "play",
        Callback = function()
            if Axs.Code == "" then
                Axs.Notify("Error", "No script opened.", "alert-triangle")
                return
            end
            Window:Dialog({
                Title = "Execute Script",
                Content = "This script was written by a third party. Only run scripts you trust.",
                Icon = "triangle-alert",
                Buttons = {
                    {
                        Title = "Execute",
                        Variant = "Primary",
                        Callback = function()
                            task.spawn(function(fn, err, ok, runErr)
                                if not loadstring then
                                    Axs.Notify("Error", "loadstring is not supported by this executor.", "alert-triangle")
                                    return
                                end
                                fn, err = loadstring(Axs.Code)
                                if not fn then
                                    Axs.Notify("Syntax Error", string.sub(tostring(err), 1, 150), "alert-triangle")
                                    return
                                end
                                Axs.Notify("Executing", Axs.Title, "play")
                                ok, runErr = pcall(fn)
                                if not ok then
                                    Axs.Notify("Script Error", string.sub(tostring(runErr), 1, 150), "alert-triangle")
                                end
                            end)
                        end,
                    },
                    {
                        Title = "Cancel",
                        Variant = "Primary",
                        Callback = function() end,
                    }
                }
            })
        end
    })

    SecEdit:Button({
        Title = "Close Script",
        Desc = "Clear the viewer and the editor",
        Icon = "x",
        Callback = function()
            Axs.Code = ""
            Axs.Title = ""
            Axs.EditReady = false
            Axs.SetPreview("-- no script opened yet")
            pcall(function() Axs.EditUI:Set("") end)
            pcall(function() Axs.ViewLabel:SetTitle("No script opened") end)
        end
    })
end










