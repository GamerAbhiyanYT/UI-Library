--[[====[ Tracker > ESP Kit (shared engine, 1 global table = almost no locals) ]== ]]
do
    if AxparnESP and AxparnESP.Shutdown then
        pcall(AxparnESP.Shutdown)
    end

    AxparnESP = {
        Supported = (Drawing ~= nil and Drawing.new ~= nil),
        Players = game:GetService("Players"),
        Run = game:GetService("RunService"),
        WS = game:GetService("Workspace"),

        FontNames = { "UI", "System", "Plex", "Monospace" },
        FontMap = { UI = 0, System = 1, Plex = 2, Monospace = 3 },
        ShadowOffsets = { { 1, 1 }, { -1, 1 }, { 1, -1 }, { -1, -1 } },

        Reserve = { health = 0, name = 0 },

        Hub = {
            list = {}, -- active trackers
            conn = nil, -- the ONE RenderStepped connection
            rem = nil, -- PlayerRemoving connection
            ctx = {}, -- reused every frame (no allocations)
            bnd = {}, -- reused bounds table
            vis = {}, -- [Player] = occlusion cache
            ext = setmetatable({}, { __mode = "k" }), -- [Character] = cached height offsets
            filter = {},
        },
    }

    AxparnESP.Hub.params = RaycastParams.new()
    AxparnESP.Hub.params.FilterType = Enum.RaycastFilterType.Exclude
    AxparnESP.Hub.params.IgnoreWater = true
    AxparnESP.Hub.params.RespectCanCollide = true

    function AxparnESP.Copy(t)
        local c = {}
        for k, v in pairs(t) do
            c[k] = v
        end
        return c
    end

    function AxparnESP.Alpha(v)
        return math.clamp(1 - (v or 0), 0, 1)
    end

    function AxparnESP.Rainbow(offset)
        return Color3.fromHSV(((os.clock() % 5) / 5 + (offset or 0)) % 1, 1, 1)
    end

    function AxparnESP.HealthColor(ratio)
        return Color3.fromHSV(math.clamp(ratio, 0, 1) * 0.33, 1, 1)
    end

    function AxparnESP.Font(name)
        local fonts = Drawing and Drawing.Fonts
        if fonts and fonts[name] ~= nil then
            return fonts[name]
        end
        return AxparnESP.FontMap[name] or 0
    end

    function AxparnESP.Notify(title, content, icon)
        WindUI:Notify({
            Title = title,
            Content = content,
            Icon = icon or "check",
            Duration = 2
        })
    end

    function AxparnESP.Set(obj, cache, key, value)
        if cache[key] ~= value then
            cache[key] = value
            obj[key] = value
        end
    end

    function AxparnESP.Extents(char, root, now)
        local ext = AxparnESP.Hub.ext
        local e = ext[char]
        if not e or now > e.exp then
            local cf, size = char:GetBoundingBox()
            local dy = cf.Position.Y - root.Position.Y
            e = e or {}
            e.top = dy + size.Y / 2
            e.bot = dy - size.Y / 2
            e.exp = now + 0.5
            ext[char] = e
        end
        return e.top, e.bot
    end

    function AxparnESP.Bounds(char, root, cam, viewport, now)
        local topOff, botOff = AxparnESP.Extents(char, root, now)
        local p = root.Position

        local t = cam:WorldToViewportPoint(Vector3.new(p.X, p.Y + topOff, p.Z))
        local b = cam:WorldToViewportPoint(Vector3.new(p.X, p.Y + botOff, p.Z))
        if t.Z <= 0 or b.Z <= 0 then return nil end

        local h = b.Y - t.Y
        if h < 2 then return nil end

        local x = (t.X + b.X) / 2
        if x < -100 or x > viewport.X + 100 or b.Y < -100 or t.Y > viewport.Y + 100 then
            return nil
        end

        local o = AxparnESP.Hub.bnd
        o.top, o.bottom, o.x, o.height, o.halfW = t.Y, b.Y, x, h, h * 0.25
        return o
    end

    function AxparnESP.IsVisible(player, char, root, cam, lchar, now)
        local H = AxparnESP.Hub
        local c = H.vis[player]
        if c and c.char == char and now < c.exp then
            return c.v
        end

        local f = H.filter
        f[1] = lchar or char
        f[2] = char
        H.params.FilterDescendantsInstances = f

        local ws = AxparnESP.WS
        local origin = cam.CFrame.Position
        local head = char:FindFirstChild("Head")

        local visible = false
        if head then
            visible = ws:Raycast(origin, head.Position - origin, H.params) == nil
        end
        if not visible then
            visible = ws:Raycast(origin, root.Position - origin, H.params) == nil
        end

        if not c then
            c = {}
            H.vis[player] = c
        end
        c.char = char
        c.v = visible
        c.exp = now + 0.08 + math.random() * 0.04
        return visible
    end

    function AxparnESP.NewLabel()
        local m = Drawing.new("Text")
        m.Center = true
        m.Outline = false
        m.ZIndex = 3
        m.Visible = false
        return { main = m, mc = { Visible = false }, sh = {}, sc = {} }
    end

    function AxparnESP.LabelHide(l)
        local Set = AxparnESP.Set
        Set(l.main, l.mc, "Visible", false)
        for i = 1, #l.sh do
            Set(l.sh[i], l.sc[i], "Visible", false)
        end
    end

    function AxparnESP.LabelRemove(l)
        pcall(function() l.main:Remove() end)
        for i = 1, #l.sh do
            local s = l.sh[i]
            pcall(function() s:Remove() end)
        end
        l.sh, l.sc = {}, {}
    end

    function AxparnESP.LabelRender(l, text, x, y, size, color, alpha, level, outlineColor, fontName, anchor)
        local E = AxparnESP
        local Set = E.Set
        local m, mc = l.main, l.mc
        local font = E.Font(fontName)

        Set(m, mc, "Text", text)
        Set(m, mc, "Size", size)
        Set(m, mc, "Font", font)

        if anchor ~= "center" then
            local w = m.TextBounds.X
            if anchor == "right" then
                x = x - w / 2
            else
                x = x + w / 2
            end
        end
        x, y = math.floor(x + 0.5), math.floor(y + 0.5)

        Set(m, mc, "Color", color)
        Set(m, mc, "Transparency", alpha)
        Set(m, mc, "Position", Vector2.new(x, y))
        Set(m, mc, "Outline", level >= 1)
        Set(m, mc, "OutlineColor", outlineColor)
        Set(m, mc, "Visible", true)

        local extra = level >= 2 and (level - 1) or 0
        if extra > 0 then
            if #l.sh == 0 then
                for i = 1, 4 do
                    local s = Drawing.new("Text")
                    s.Center = true
                    s.Outline = false
                    s.ZIndex = 2
                    s.Visible = false
                    l.sh[i] = s
                    l.sc[i] = { Visible = false }
                end
            end
            local offs = E.ShadowOffsets
            for i = 1, 4 do
                local s, c = l.sh[i], l.sc[i]
                Set(s, c, "Text", text)
                Set(s, c, "Size", size)
                Set(s, c, "Font", font)
                Set(s, c, "Color", outlineColor)
                Set(s, c, "Transparency", alpha)
                Set(s, c, "Position", Vector2.new(x + offs[i][1] * extra, y + offs[i][2] * extra))
                Set(s, c, "Visible", true)
            end
        else
            for i = 1, #l.sh do
                Set(l.sh[i], l.sc[i], "Visible", false)
            end
        end
    end

    function AxparnESP.DestroyObj(tr, player)
        local o = tr.objs[player]
        if o then
            pcall(tr.cb.destroy, o)
            tr.objs[player] = nil
        end
    end

    function AxparnESP.Hub.Step(dt)
        local E = AxparnESP
        local H = E.Hub
        local list = H.list
        local n = #list
        local cam = E.WS.CurrentCamera
        if n == 0 or not cam then return end

        local Players = E.Players
        local lp = Players.LocalPlayer
        local lchar = lp.Character
        local lroot = lchar and lchar:FindFirstChild("HumanoidRootPart")
        local origin = lroot and lroot.Position or cam.CFrame.Position
        local viewport = cam.ViewportSize
        local myTeam = lp.Team
        local now = os.clock()
        local ctx = H.ctx
        ctx.dt = dt

        for _, player in ipairs(Players:GetPlayers()) do
            local char = player ~= lp and player.Character or nil
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local alive = root ~= nil and hum ~= nil and hum.Health > 0

            local dist, bounds, boundsDone, visible, visDone
            if alive then
                dist = (root.Position - origin).Magnitude
                ctx.player, ctx.char, ctx.root, ctx.hum, ctx.dist = player, char, root, hum, dist
            end

            for i = 1, n do
                local tr = list[i]
                local cfg = tr.cfg
                local show = false

                if alive and dist <= cfg.MaxDistance
                    and not (cfg.HideTeammates and myTeam ~= nil and player.Team == myTeam) then

                    if not boundsDone then
                        boundsDone = true
                        bounds = E.Bounds(char, root, cam, viewport, now)
                        ctx.bounds = bounds
                    end

                    if bounds then
                        if cfg.DepthMode == "Occluded" then
                            if not visDone then
                                visDone = true
                                visible = E.IsVisible(player, char, root, cam, lchar, now)
                            end
                            show = visible
                        else
                            show = true
                        end
                    end
                end

                local o = tr.objs[player]
                if show then
                    if not o then
                        o = {}
                        tr.objs[player] = o
                    end
                    local ok, err = pcall(tr.cb.render, o, ctx)
                    if not ok then
                        pcall(tr.cb.hide, o)
                        if not tr.warned then
                            tr.warned = true
                            warn("[Axparn ESP] render error:", err)
                        end
                    end
                elseif o then
                    tr.cb.hide(o)
                end
            end
        end
    end

    function AxparnESP.Hub.Add(tr)
        local E = AxparnESP
        local H = E.Hub

        for _, t in ipairs(H.list) do
            if t == tr then return end
        end
        table.insert(H.list, tr)

        if not H.conn then
            H.conn = E.Run.RenderStepped:Connect(H.Step)
            H.rem = E.Players.PlayerRemoving:Connect(function(p)
                for _, t in ipairs(H.list) do
                    E.DestroyObj(t, p)
                end
                H.vis[p] = nil
            end)
        end
    end

    function AxparnESP.Hub.Remove(tr)
        local E = AxparnESP
        local H = E.Hub

        for i, t in ipairs(H.list) do
            if t == tr then
                table.remove(H.list, i)
                break
            end
        end
        for player in pairs(tr.objs) do
            E.DestroyObj(tr, player)
        end

        if #H.list == 0 then
            if H.conn then H.conn:Disconnect() H.conn = nil end
            if H.rem then H.rem:Disconnect() H.rem = nil end
            table.clear(H.vis)
            table.clear(H.ext)
        end
    end

    function AxparnESP.NewTracker(cfg, cb)
        local E = AxparnESP
        local tr = { cfg = cfg, cb = cb, objs = {}, warned = false, running = false }

        function tr:Start()
            if self.running then return end
            if not E.Supported then
                E.Notify("Unsupported", "Your executor does not support the Drawing library", "triangle-alert")
                return
            end
            self.running = true
            E.Hub.Add(self)
        end

        function tr:Stop()
            self.running = false
            E.Hub.Remove(self)
        end

        function tr:Rebuild()
            if self.running then
                self:Stop()
                self:Start()
            end
        end

        return tr
    end

    function AxparnESP.Shutdown()
        local copy = {}
        for i, t in ipairs(AxparnESP.Hub.list) do
            copy[i] = t
        end
        for _, t in ipairs(copy) do
            t:Stop()
        end
    end

    function AxparnESP.BuildUI(section, cfg, defaults, specs, onChange)
        local controls = {}

        for _, s in ipairs(specs) do
            local key = s.key

            local function changed(value)
                cfg[key] = value
                if onChange then
                    onChange(key, value)
                end
            end

            if s.type == "divider" then
                section:Divider()
            elseif s.type == "toggle" then
                controls[key] = section:Toggle({
                    Title = s.title, Desc = s.desc,
                    Value = cfg[key], Callback = changed
                })
            elseif s.type == "slider" then
                controls[key] = section:Slider({
                    Title = s.title, Desc = s.desc,
                    Step = s.step or 1,
                    Value = { Min = s.min, Max = s.max, Default = cfg[key] },
                    Callback = changed
                })
            elseif s.type == "color" then
                controls[key] = section:Colorpicker({
                    Title = s.title, Desc = s.desc,
                    Default = cfg[key], Transparency = 0, Locked = false,
                    Callback = changed
                })
            elseif s.type == "dropdown" then
                controls[key] = section:Dropdown({
                    Title = s.title, Desc = s.desc,
                    Values = s.values, Value = cfg[key],
                    Callback = changed
                })
            end
        end

        local function reset()
            for _, s in ipairs(specs) do
                local key = s.key
                if key and not s.noReset then
                    local value = defaults[key]
                    cfg[key] = value

                    local c = controls[key]
                    if c then
                        pcall(function()
                            if s.type == "toggle" then
                                c:SetValue(value)
                            elseif s.type == "slider" then
                                c:Set(value)
                            elseif s.type == "color" then
                                c:Set(value, 0)
                            elseif s.type == "dropdown" then
                                c:Select(value)
                            end
                        end)
                    end
                end
            end
            if onChange then
                onChange(nil, nil)
            end
        end

        return controls, reset
    end

    function AxparnESP.BuildManagement(tab, label, reset, reload)
        local sec = tab:Section({
            Title = "Preset Management",
            Box = true,
            TextXAlignment = "Left",
            TextSize = 17,
            Opened = true,
        })

        sec:Button({
            Title = "Reset to Default",
            Desc = "Restore " .. label .. " settings to default",
            Callback = function()
                reset()
                AxparnESP.Notify("Success!", "now back to the Default")
            end
        })

        sec:Button({
            Title = "Reload Settings",
            Desc = "Rebuild " .. label .. " for all players manually",
            Callback = function()
                reload()
                AxparnESP.Notify("Success!", label .. " refreshed")
            end
        })

        return sec
    end
end

--[[====[ Tracker > healthBar  (global variables: HB_*) ]== ]]
do
    HB_Config = {
        Enabled = false,
        ShowIndicator = false,

        DepthMode = "AlwaysOnTop",

        AutoColorBar = true,
        AutoColorIndicator = true,
        BarColor = Color3.fromHex("#00FF00"),
        BarRGB = false,
        IndicatorColor = Color3.fromHex("#FFFFFF"),

        Side = "Left",          -- Left / Right (vertical) / Top (horizontal, above the head)
        BarThickness = 3,
