                        if p1 and p2 and p1.Parent and p2.Parent then
                            local v1, onScreen1 = camera:WorldToViewportPoint(p1.Position)
                            local v2, onScreen2 = camera:WorldToViewportPoint(p2.Position)

                            if onScreen1 or onScreen2 then
                                line.From = Vector2.new(v1.X, v1.Y)
                                line.To = Vector2.new(v2.X, v2.Y)
                                line.Color = currentRainbowColor
                                line.Transparency = alpha
                                line.Thickness = SkeletonConfig.Thickness
                                line.Visible = true
                            else
                                line.Visible = false
                            end
                        else
                            line.Visible = false
                        end
                    end
                else
                    removeSkeleton(player)
                end
            end
        end
    end)
    
